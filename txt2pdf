def resolve_font_spec(font_arg: str = None, fmt: str = "br2") -> Tuple[str, str]:
    """Löst die typografische Schriftartenspezifikation für den Textkörper deterministisch auf."""
    if font_arg:
        cleaned = font_arg.strip().lower()
        if cleaned not in ("", "none", "auto", "default"):
            if cleaned in FONT_DEFINITIONS:
                return FONT_DEFINITIONS[cleaned]["spec"], FONT_DEFINITIONS[cleaned]["name"]
            return f'("{font_arg.strip()}", "Optima", "PT Serif", "Times New Roman")', font_arg.strip()

    if fmt == "atk":
        return FONT_DEFINITIONS["garamond"]["spec"], "Garamond"
    elif fmt in ("br2", "br1"):
        return FONT_DEFINITIONS["pt serif"]["spec"], "PT Serif"
    elif fmt == "apa":
        return FONT_DEFINITIONS["times new roman"]["spec"], "Times New Roman"
    else:
        return FONT_DEFINITIONS["garamond"]["spec"], "Garamond"

def resolve_title_font_spec(fmt: str, body_font_spec: str) -> str:
    """Löst die typografische Schriftartenspezifikation für die Hauptüberschrift (Titel) auf."""
    if fmt == "atk":
        return FONT_DEFINITIONS["didot"]["spec"]
    return body_font_spec

def resolve_heading_font_spec(fmt: str, body_font_spec: str) -> str:
    """Löst die typografische Schriftartenspezifikation für sämtliche Überschriften auf."""
    return body_font_spec

