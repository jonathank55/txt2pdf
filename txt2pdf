def generate_bibliography_typst(
    urls: List[str] = None,
    explicit_entries: List[str] = None,
    bib_title: str = "Literaturverzeichnis",
    font_spec: str = '("PT Serif", "EB Garamond", "Times New Roman")',
    font_size: str = "8pt",
    title_size: str = "14pt",
    context_text: str = "",
    hanging_indent: str = "12.7mm",
    leading: str = "0.35em",
    use_body_indent: bool = False,
    indent_str: str = "3.8mm"
) -> str:
    """Erzeugt das standardkonforme APA-Literaturverzeichnis im Blocktext mit vorangestellter Trennlinie, zentrierter Überschrift und synchronisiertem Zeilenabstand."""
    citations = []
    seen_formatted = set()
    seen_urls = set()
    seen_titles = set()

    raw_candidates = []
    if explicit_entries:
        for e in explicit_entries:
            s_e = e.strip()
            if s_e and s_e not in raw_candidates:
                raw_candidates.append(s_e)
    if urls:
        for u in urls:
            s_u = u.strip()
            if s_u and s_u not in raw_candidates:
                raw_candidates.append(s_u)

    for item in raw_candidates:
        cit = format_citation_to_apa_7(item, context_text=context_text)
        if cit and cit.get("formatted"):
            norm_f = cit["formatted"].strip().lower()
            c_url = cit.get("clean_url", "").strip().lower()
            t_key = cit.get("title_key", "").strip().lower()
            
            # Duplikaterkennung über formatierten String, identische URL oder identischen Titelstamm
            if norm_f in seen_formatted:
                continue
            if c_url and c_url in seen_urls:
                continue
            if t_key and len(t_key) >= 15 and t_key in seen_titles:
                continue
                
            seen_formatted.add(norm_f)
            if c_url:
                seen_urls.add(c_url)
            if t_key and len(t_key) >= 15:
                seen_titles.add(t_key)
            citations.append(cit)

    if not citations:
        return ""

    citations.sort(key=lambda c: c["sort_key"])

    entries_typst = []
    if use_body_indent:
        for idx, c in enumerate(citations):
            if idx == 0:
                entries_typst.append(f"#block(inset: (bottom: 0pt))[\n  {c['formatted']}\n]")
            else:
                entries_typst.append(f"#block(inset: (bottom: 0pt))[\n  #h({indent_str}){c['formatted']}\n]")
        par_hanging = "0pt"
    else:
        for c in citations:
            entries_typst.append(f"#block(inset: (bottom: 3.5mm))[\n  {c['formatted']}\n]")
        par_hanging = hanging_indent

    body = "\n".join(entries_typst)

    return f"""
#v(1.8em)
#line(length: 100%, stroke: 0.3pt + rgb("#000000"))
#v(1.2em)
#align(center)[
  #text(size: {title_size}, weight: "bold", fill: rgb("#000000"))[{escape_typst_line(bib_title)}]
]
#v(1.2em)

#show link: set text(fill: rgb("#0b57d0"))
#set text(font: {font_spec}, size: {font_size}, costs: (hyphenation: 2000%))
#set par(
  hanging-indent: {par_hanging},
  leading: {leading},
  spacing: {leading},
  justify: true,
  linebreaks: "optimized"
)

{body}
"""

def format_figure_typst(img_path: str, caption_title: str = "", source: str = "", placement: str = "bottom", width: str = "117mm", caption_size: str = "6pt") -> str:
    """Formatiert eine Abbildung mit dezentem Rahmen und normierter Bildunterschrift."""
    abs_img = os.path.abspath(img_path)
    escaped_caption = escape_typst_line(caption_title) if caption_title else ""
    escaped_source = escape_typst_line(source) if source else ""
    source_clause = f" _Quelle: {escaped_source}._" if escaped_source else ""

    caption_block = ""
    if escaped_caption or source_clause:
        caption_block = f"""
      #v(1.4mm)
      #text(size: {caption_size}, fill: rgb("#000000"))[
        {escaped_caption}{source_clause}
      ]"""

    return (
        f"\n#align(center)[\n"
        f"  #block(width: 100%, stroke: 0.35pt + rgb(\"#000000\"), radius: 2pt, clip: true)[\n"
        f"    #image(\"{abs_img}\", width: 100%, fit: \"contain\")\n"
        f"  ]{caption_block}\n"
        f"]\n#v(2.5mm)\n"
    )

def parse_body_to_typst(raw_lines: list, images: list = None, caption_size: str = "6pt", use_initial: bool = True, doc_dir: str = "", hanging_indent: str = "6mm", title_font_spec: str = None) -> Tuple[str, List[str], List[str], str, bool]:
    """Wandelt Textzeilen in Typst-Code um, verarbeitet Überschriften, trennt APA-Zitate für die Extraseite und extrahiert Links."""
    full_raw_text = "\n".join(raw_lines)
    all_urls = extract_urls_from_text(full_raw_text)

    bib_header_exact_regex = re.compile(
        r"^(?:Literaturverzeichnis|Quellenverzeichnis|Works Cited|Bibliography|Literatur|Quellen|References|Library|Referencias|Bibliografía|Fuentes)\b:?\s*$",
        re.IGNORECASE
    )
    bib_header_prefix_regex = re.compile(
        r"^(Literaturverzeichnis|Quellenverzeichnis|Works Cited|Bibliography|Literatur|Quellen|References|Library|Referencias|Bibliografía|Fuentes)\b:?\s+(.+)$",
        re.IGNORECASE
    )

    paragraphs = []
    current_lines = []
    current_indent = False
    current_blank_before = False
    had_blank_line = False

    for line in raw_lines:
        s = line.strip()
        if not s:
            if current_lines:
                paragraphs.append({
                    "text": "\n".join(current_lines),
                    "has_indent": current_indent,
                    "has_blank_before": current_blank_before
                })
                current_lines = []
                current_indent = False
            had_blank_line = True
            continue

        is_indented_line = bool(line.startswith("\t") or line.startswith("  ") or (len(line) > len(line.lstrip()) and bool(line.strip())))

        if bib_header_exact_regex.match(s):
            if current_lines:
                paragraphs.append({
                    "text": "\n".join(current_lines),
                    "has_indent": current_indent,
                    "has_blank_before": current_blank_before
                })
                current_lines = []
                current_indent = False
            paragraphs.append({
                "text": s,
                "has_indent": False,
                "has_blank_before": had_blank_line
            })
            had_blank_line = False
            continue

        m_pref = bib_header_prefix_regex.match(s)
        if m_pref:
            if current_lines:
                paragraphs.append({
                    "text": "\n".join(current_lines),
                    "has_indent": current_indent,
                    "has_blank_before": current_blank_before
                })
                current_lines = []
                current_indent = False
            paragraphs.append({
                "text": m_pref.group(1).strip(),
                "has_indent": False,
                "has_blank_before": had_blank_line
            })
            had_blank_line = False
            rest_line = m_pref.group(2).strip()
            if rest_line:
                paragraphs.append({
                    "text": rest_line,
                    "has_indent": is_indented_line,
                    "has_blank_before": False
                })
            continue

        is_quote = (
            len(s) <= 280 and (
                (s.startswith("»") and s.endswith("«")) or
                (s.startswith("„") and s.endswith("“")) or
                (s.startswith('"') and s.endswith('"')) or
                (s.startswith("“") and s.endswith("”"))
            )
        )
        if is_quote:
            if current_lines:
                paragraphs.append({
                    "text": "\n".join(current_lines),
                    "has_indent": current_indent,
                    "has_blank_before": current_blank_before
                })
                current_lines = []
                current_indent = False
            paragraphs.append({
                "text": s,
                "has_indent": False,
                "has_blank_before": had_blank_line
            })
            had_blank_line = False
            continue

        is_md_block = bool(
            re.match(r"^#{1,4}\s+", s) or
            s.startswith(">") or
            re.match(r"^[-*•]\s+", s)
        )
        if is_md_block:
            if current_lines:
                paragraphs.append({
                    "text": "\n".join(current_lines),
                    "has_indent": current_indent,
                    "has_blank_before": current_blank_before
                })
                current_lines = []
                current_indent = False
            paragraphs.append({
                "text": s,
                "has_indent": False,
                "has_blank_before": had_blank_line
            })
            had_blank_line = False
            continue

        if is_indented_line and current_lines:
            paragraphs.append({
                "text": "\n".join(current_lines),
                "has_indent": current_indent,
                "has_blank_before": current_blank_before
            })
            current_lines = []
            current_indent = True
            current_blank_before = False

        if not current_lines:
            current_indent = is_indented_line
            current_blank_before = had_blank_line
            had_blank_line = False
        current_lines.append(s)

    if current_lines:
        paragraphs.append({
            "text": "\n".join(current_lines),
            "has_indent": current_indent,
            "has_blank_before": current_blank_before
        })

    image_extensions = (".png", ".jpg", ".jpeg", ".webp", ".pdf", ".gif", ".svg", ".tiff", ".tif")
    typst_elements = []
    explicit_bib_entries = []
    bib_heading_title = None
    first_body_para_done = False
    heading_2_done = False
    in_bibliography_section = False
    has_explicit_bibliography = False
    last_element_was_body_para = False

    chapter_header_regex = re.compile(
        r"^(?:KAPITEL|Kapitel|CHAPTER|Chapter|ABSCHNITT|Abschnitt|SECTION|Section|TEIL|Teil|MODUL|Modul|LEKTION|Lektion|THEMA|Thema|EINHEIT|Einheit)\s+([0-9IVXLCDM]+|[A-Z])(?:\s*[:\-\.\–—]\s*(.*)|$)",
        re.IGNORECASE
    )
    numbered_header_regex = re.compile(r"^(\d+(?:\.\d+)*[\.:\)]\s+[A-ZÄÖÜ].*)$")
    roman_header_regex = re.compile(r"^([IVXLCDM]+[\.:\)]\s+[A-ZÄÖÜ].*)$")
    alpha_header_regex = re.compile(r"^([A-Z]\.\s+[A-ZÄÖÜ].*)$")
    bib_header_regex = re.compile(r"^(?:Literaturverzeichnis|Quellenverzeichnis|Works Cited|Bibliography|Literatur|Quellen|References|Library|Referencias|Bibliografía|Fuentes)\b:?\s*$", re.IGNORECASE)
    bib_header_inline_regex = re.compile(r"^(?:Literaturverzeichnis|Quellenverzeichnis|Works Cited|Bibliography|Literatur|Quellen|References|Library|Referencias|Bibliografía|Fuentes)\b:?\s*(.*)$", re.IGNORECASE)

    for i, p_info in enumerate(paragraphs):
        para = p_info["text"]
        para_has_indent = p_info["has_indent"]
        para_has_blank_before = p_info.get("has_blank_before", False)
        lines_in_para = para.splitlines()
        first_line = lines_in_para[0].strip()
        flat_text = " ".join(l.strip() for l in lines_in_para).strip()
        is_single_line = (len(lines_in_para) == 1)

        # 0. Explizite Inline-Abbildung: ##Pfad/zur/Datei
        if is_single_line and first_line.startswith("##") and not first_line.startswith("###"):
            target_str = first_line[2:].strip()
            target_clean = target_str.strip("\"'")
            resolved_img = None
            if os.path.isabs(target_clean) and os.path.exists(target_clean):
                resolved_img = target_clean
            elif doc_dir and os.path.exists(os.path.join(doc_dir, target_clean)):
                resolved_img = os.path.join(doc_dir, target_clean)
            elif any(target_clean.lower().endswith(ext) for ext in image_extensions):
                resolved_img = target_clean

            if resolved_img:
                top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
                fig_code = format_figure_typst(resolved_img, caption_size=caption_size)
                typst_elements.append(f"{top_v}{fig_code}")
                continue

        # 1. Zitat-Zwischenüberschriften (fett, zentriert)
        is_quote_heading = (
            len(flat_text) <= 280 and (
                (flat_text.startswith("»") and flat_text.endswith("«")) or
                (flat_text.startswith("„") and flat_text.endswith("“")) or
                (flat_text.startswith('"') and flat_text.endswith('"')) or
                (flat_text.startswith("“") and flat_text.endswith("”"))
            )
        )
        if is_quote_heading:
            escaped = format_content_to_typst(flat_text)
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            typst_elements.append(
                f"{top_v}#align(center)[\n  #par(justify: false)[\n    #text(weight: \"bold\", fill: rgb(\"#000000\"))[{escaped}]\n  ]\n]\n"
            )
            continue

        # 2. Markdown-Blockquote (> ...)
        if first_line.startswith(">"):
            quote_text = " ".join(re.sub(r"^>\s*", "", l).strip() for l in lines_in_para)
            escaped_quote = format_content_to_typst(quote_text)
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            if len(quote_text) <= 200:
                typst_elements.append(
                    f"{top_v}#align(center)[\n  #block(width: 95%)[\n    #text(weight: \"bold\", fill: rgb(\"#000000\"))[{escaped_quote}]\n  ]\n]\n"
                )
            else:
                typst_elements.append(
                    f"{top_v}#block(inset: (left: 2.5mm), stroke: (left: 1.5pt + rgb(\"#000000\")))"
                    f"[#text(weight: \"bold\", fill: rgb(\"#000000\"))[{escaped_quote}]]\n"
                )
            continue

        # 3. Markdown-Überschriften (#, ##, ###, ####)
        if first_line.startswith("#### "):
            h_text = escape_typst_line(first_line[5:].strip())
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            typst_elements.append(f"{top_v}#text(weight: \"bold\", fill: rgb(\"#000000\"))[{h_text}]\n")
            continue
        elif first_line.startswith("### "):
            h_text = escape_typst_line(first_line[4:].strip())
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            typst_elements.append(f"{top_v}#text(weight: \"bold\", fill: rgb(\"#000000\"))[{h_text}]\n")
            continue
        elif first_line.startswith("## "):
            h_text = escape_typst_line(first_line[3:].strip())
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            typst_elements.append(f"{top_v}#text(weight: \"bold\", fill: rgb(\"#000000\"))[{h_text}]\n")
            continue
        elif first_line.startswith("# "):
            h_text = escape_typst_line(first_line[2:].strip())
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            typst_elements.append(f"{top_v}#text(weight: \"bold\", fill: rgb(\"#000000\"))[{h_text}]\n")
            continue

        # 4. Explizite Kapitel- / Abschnittsüberschriften (KAPITEL 1: ..., Chapter 2 ...)
        if is_single_line and len(first_line) <= 160 and chapter_header_regex.match(first_line):
            h_text = escape_typst_line(first_line)
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            typst_elements.append(f"{top_v}#text(weight: \"bold\", fill: rgb(\"#000000\"))[{h_text}]\n")
            continue

        # 5. Nummerierte & alphabetische Gliederungsüberschriften (1. ..., 1.1 ..., I. ..., A. ...)
        is_numbered_heading = is_single_line and len(first_line) <= 120 and (
            numbered_header_regex.match(first_line) or
            roman_header_regex.match(first_line) or
            alpha_header_regex.match(first_line)
        )
        if is_numbered_heading:
            h_text = escape_typst_line(first_line)
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            typst_elements.append(f"{top_v}#text(weight: \"bold\", fill: rgb(\"#000000\"))[{h_text}]\n")
            continue

        # 6. Literaturverzeichnis-Abschnittsüberschrift oder reiner Bibliografie-Block
        def is_source_line_check(line_str: str) -> bool:
            s_l = line_str.strip()
            if not s_l:
                return False
            if s_l.startswith(("http://", "https://", "doi:", "10.")) or re.match(r"^https?://", s_l) or re.match(r"^10\.\d{4,9}/", s_l):
                return True
            if bool(extract_isbns_from_text(s_l)):
                return True
            if is_apa_citation(s_l):
                return True
            return False

        is_all_urls = bool(lines_in_para and all(is_source_line_check(l) for l in lines_in_para))

        m_bib_header = bib_header_inline_regex.match(flat_text)
        if m_bib_header:
            in_bibliography_section = True
            has_explicit_bibliography = True
            first_w = flat_text.split()[0].rstrip(":").strip()
            if first_w.isupper() and len(first_w) > 3:
                bib_heading_title = first_w.capitalize()
            elif first_w:
                bib_heading_title = first_w

            remainder = m_bib_header.group(1).strip()
            if remainder:
                candidate_urls = re.findall(r"https?://[^\s<>\"\'\[\]]+|\bdoi:\s*10\.\d{4,9}/[^\s<>\"\'\[\]]+|\b10\.\d{4,9}/[^\s<>\"\'\[\]]+", remainder)
                if candidate_urls:
                    for cu in candidate_urls:
                        explicit_bib_entries.append(cu.strip())
                elif len(remainder) >= 15 and not bib_header_exact_regex.match(remainder):
                    explicit_bib_entries.append(remainder)
            continue

        # 7. APA-Zitate / Literaturangaben / reine URL-Blöcke (werden isoliert für die Extraseite gesammelt)
        if in_bibliography_section or is_apa_citation(flat_text) or is_all_urls:
            in_bibliography_section = True
            has_explicit_bibliography = True
            candidate_lines = [l.strip() for l in lines_in_para if l.strip()]
            for l in candidate_lines:
                if bib_header_exact_regex.match(l):
                    continue
                urls_in_line = re.findall(r"https?://[^\s<>\"\'\[\]]+|\bdoi:\s*10\.\d{4,9}/[^\s<>\"\'\[\]]+|\b10\.\d{4,9}/[^\s<>\"\'\[\]]+", l)
                if urls_in_line and (len(urls_in_line) > 1 or is_all_urls):
                    for single_u in urls_in_line:
                        explicit_bib_entries.append(single_u.strip())
                else:
                    explicit_bib_entries.append(l)
            continue

        # 8. Versalien-Überschriften (ALL CAPS / Großbuchstaben) -> Große Überschrift: Zentriert & Fett
        alpha_chars = re.findall(r"[A-Za-zÄÖÜäöüß]", flat_text)
        is_all_caps = len(alpha_chars) >= 3 and flat_text.isupper() and len(flat_text) <= 200 and len(flat_text.split()) <= 20
        if is_all_caps:
            h_text = escape_typst_line(flat_text)
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            typst_elements.append(
                f"{top_v}#align(center)[\n  #par(justify: false)[\n    #text(weight: \"bold\", fill: rgb(\"#000000\"))[{h_text}]\n  ]\n]\n"
            )
            continue

        # 9. Aufzählungspunkte
        if first_line.startswith(("- ", "* ", "• ")):
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            list_lines = []
            for l in lines_in_para:
                item_text = format_content_to_typst(re.sub(r"^[-*•]\s+", "", l.strip()))
                list_lines.append(f"- {item_text}\n")
            typst_elements.append(f"{top_v}{''.join(list_lines)}")
            continue

        # 10. Überschriften: Alle einzelnen Sätze oder Phrasen (mit oder ohne Punkt) werden als Überschrift erkannt (Zentriert & Fett)
        if is_heading_sentence(flat_text):
            h_text = format_content_to_typst(flat_text)
            top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
            typst_elements.append(
                f"{top_v}#align(center)[\n  #par(justify: false)[\n    #text(weight: \"bold\", fill: rgb(\"#000000\"))[{h_text}]\n  ]\n]\n"
            )
            continue

        # 11. Regulärer Fließtextabsatz (Standard mit optionalem Initial im 1. Fließtext-Absatz)
        escaped_para = format_content_to_typst(flat_text)
        top_v = "#v(0.8em)\n" if (para_has_blank_before and typst_elements) else ""
        if use_initial and not first_body_para_done:
            escaped_para = apply_initial_to_typst_element(escaped_para, font_spec=title_font_spec)
            if top_v:
                escaped_para = f"{top_v}{escaped_para}"
        else:
            if para_has_indent:
                escaped_para = f"#h(3.8mm){escaped_para}"
            if top_v:
                escaped_para = f"{top_v}{escaped_para}"
        first_body_para_done = True
        typst_elements.append(escaped_para + "\n")

    # Falls Bilder über -i übergeben wurden, diese am Ende anhängen
    if images:
        for img_p in images:
            if os.path.exists(img_p):
                typst_elements.append(format_figure_typst(img_p, caption_size=caption_size))

    # Erkennt, ob der Fließtext primär Einzüge nutzt
    doc_has_indents = any(p.get("has_indent", False) for p in paragraphs)

    return "\n".join(typst_elements), all_urls, explicit_bib_entries, bib_heading_title, doc_has_indents

DATE_PATTERNS = [
    r"^(?:Datum|Date):\s*(.+)$",
    r"^(\d{1,2}\.\s*(?:Januar|Februar|März|April|Mai|Juni|Juli|August|September|Oktober|November|Dezember|Jan|Feb|Mär|Apr|Mai|Jun|Jul|Aug|Sep|Okt|Nov|Dez)\s+\d{4})$",
    r"^((?:January|February|March|April|May|June|July|August|September|October|November|December)\s+\d{1,2},?\s+\d{4})$",
    r"^(\d{1,2}\.\d{1,2}\.\d{2,4})$",
    r"^(\d{4}-\d{2}-\d{2})$"
]

class RTFHTMLToTypstParser(HTMLParser):
    """Konvertiert aus RTF generiertes HTML verlustfrei in Typst-Code unter Beibehaltung aller Formatierungen."""
    def __init__(self, base_dir: str = "", caption_size: str = "6pt"):
        super().__init__()
        self.base_dir = base_dir
        self.caption_size = caption_size
        self.css_rules = {}
        self.paragraphs = []
        self.curr_buf = []
        self.curr_plain = []
        self.tag_stack = []
        self.curr_align = None
        self.curr_heading = False
        self.had_empty_paragraph = False
        self.in_style = False
        self.style_text = []
        self.in_title = False
        self.title_text = []
        self.doc_title = ""
        self.doc_author = ""
        self.doc_date = ""
        self.list_stack = []
        self.table_data = []
        self.current_row = []
        self.in_table = False
        self.in_cell = False
        self.cell_content = []
        self.urls = []
        self.curr_indent = False

    def parse_css(self, text: str):
        rules = re.findall(r'(?:[a-zA-Z0-9_\-]+\.)?([a-zA-Z0-9_\-]+)\s*\{([^}]+)\}', text)
        for cls_name, rule_str in rules:
            self.css_rules[cls_name.strip()] = rule_str.strip()

    def handle_starttag(self, tag: str, attrs: list):
        attr_dict = dict(attrs)
        style_val = attr_dict.get('style', '')
        cls_val = attr_dict.get('class', '')
        cls_style = self.css_rules.get(cls_val, '') if cls_val else ''
        combined_style = (style_val + ';' + cls_style).lower()

        if tag == 'style':
            self.in_style = True
            return
        if tag == 'title':
            self.in_title = True
            return
        if tag == 'meta':
            name_attr = attr_dict.get('name', '').lower()
            if name_attr in ('author', 'creator'):
                self.doc_author = attr_dict.get('content', '').strip()
            elif name_attr in ('date', 'creationtime', 'created'):
                self.doc_date = attr_dict.get('content', '').strip()
            return

        align = None
        if 'text-align: center' in combined_style or 'text-align:center' in combined_style:
            align = 'center'
        elif 'text-align: right' in combined_style or 'text-align:right' in combined_style:
            align = 'right'

        m_indent = re.search(r'text-indent:\s*([0-9.]+)\s*(px|pt|em|rem|mm|cm)?', combined_style)
        has_indent = bool(m_indent and float(m_indent.group(1)) > 0)
        if 'apple-tab-span' in cls_val.lower() or 'apple-tab-span' in style_val.lower():
            self.curr_indent = True

        if tag in ('p', 'div', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6'):
            self.curr_buf = []
            self.curr_plain = []
            self.curr_align = align
            self.curr_heading = tag in ('h1', 'h2', 'h3', 'h4')
            self.curr_indent = has_indent
            self.tag_stack.append((tag, []))
        elif tag == 'img':
            src = attr_dict.get('src', '')
            if src:
                # file:/// oder relativen Pfad auflösen
                clean_src = src.replace('file://', '')
                clean_src = urllib.parse.unquote(clean_src)
                resolved_src = None
                if os.path.isabs(clean_src) and os.path.exists(clean_src):
                    resolved_src = clean_src
                elif self.base_dir and os.path.exists(os.path.join(self.base_dir, os.path.basename(clean_src))):
                    resolved_src = os.path.join(self.base_dir, os.path.basename(clean_src))
                elif self.base_dir and os.path.exists(os.path.join(self.base_dir, clean_src)):
                    resolved_src = os.path.join(self.base_dir, clean_src)
                elif os.path.exists(clean_src):
                    resolved_src = os.path.abspath(clean_src)

                if resolved_src:
                    fig_code = format_figure_typst(resolved_src, caption_size=self.caption_size)
                    self.curr_buf.append(f"\n{fig_code}\n")
                    self.curr_plain.append("[Abbildung]")
        elif tag == 'span':
            wrappers = []
            if 'underline' in combined_style:
                self.curr_buf.append('#underline[')
                wrappers.append('underline')
            if 'line-through' in combined_style:
                self.curr_buf.append('#strike[')
                wrappers.append('strike')
            if 'bold' in combined_style or 'font-weight: 700' in combined_style or 'font-weight: bold' in combined_style:
                self.curr_buf.append('#strong[')
                wrappers.append('strong')
            if 'italic' in combined_style or 'font-style: italic' in combined_style:
                self.curr_buf.append('#emph[')
                wrappers.append('emph')
            self.tag_stack.append((tag, wrappers))
        elif tag in ('b', 'strong'):
            self.curr_buf.append('#strong[')
            self.tag_stack.append((tag, ['strong']))
        elif tag in ('i', 'em'):
            self.curr_buf.append('#emph[')
            self.tag_stack.append((tag, ['emph']))
        elif tag == 'u':
            self.curr_buf.append('#underline[')
            self.tag_stack.append((tag, ['underline']))
        elif tag in ('s', 'strike', 'del'):
            self.curr_buf.append('#strike[')
            self.tag_stack.append((tag, ['strike']))
        elif tag == 'sub':
            self.curr_buf.append('#sub[')
            self.tag_stack.append((tag, ['sub']))
        elif tag in ('super', 'sup'):
            self.curr_buf.append('#super[')
            self.tag_stack.append((tag, ['super']))
        elif tag == 'a':
            href = attr_dict.get('href', '')
            if href:
                self.urls.append(href)
                self.curr_buf.append(f'#link(\"{href}\")[')
            else:
                self.curr_buf.append('[')
            self.tag_stack.append((tag, ['link']))
        elif tag == 'br':
            self.curr_buf.append('#linebreak() ')
        elif tag == 'ul':
            self.list_stack.append('ul')
        elif tag == 'ol':
            self.list_stack.append('ol')
        elif tag == 'li':
            prefix = '+ ' if (self.list_stack and self.list_stack[-1] == 'ol') else '- '
            self.curr_buf.append(f'\n{prefix}')
        elif tag == 'table':
            self.in_table = True
            self.table_data = []
        elif tag == 'tr':
            self.current_row = []
        elif tag in ('td', 'th'):
            self.in_cell = True
            self.cell_content = []

    def handle_endtag(self, tag: str):
        if tag == 'style':
            self.in_style = False
            self.parse_css(''.join(self.style_text))
            return
        if tag == 'title':
            self.in_title = False
            self.doc_title = ''.join(self.title_text).strip()
            return

        if tag in ('p', 'div', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6'):
            if self.tag_stack:
                self.tag_stack.pop()
            inner_typst = ''.join(self.curr_buf).strip()
            inner_plain = ''.join(self.curr_plain).strip()
            inner_typst = re.sub(r'#(?:strong|emph|underline|strike|sub|super)\[\s*\]', '', inner_typst).strip()
            if inner_plain:
                self.paragraphs.append({
                    'typst': inner_typst,
                    'plain': inner_plain,
                    'align': self.curr_align,
                    'heading': self.curr_heading,
                    'has_indent': self.curr_indent,
                    'has_blank_before': self.had_empty_paragraph
                })
                self.had_empty_paragraph = False
            else:
                self.had_empty_paragraph = True
            self.curr_buf = []
            self.curr_plain = []
            self.curr_indent = False
        elif tag in ('span', 'b', 'strong', 'i', 'em', 'u', 's', 'strike', 'del', 'sub', 'super', 'sup', 'a'):
            if self.tag_stack:
                popped_tag, wrappers = self.tag_stack.pop()
                for _ in wrappers:
                    self.curr_buf.append(']')
        elif tag in ('ul', 'ol'):
            if self.list_stack:
                self.list_stack.pop()
                self.curr_buf.append('\n')
        elif tag in ('td', 'th'):
            self.in_cell = False
            self.current_row.append(''.join(self.cell_content).strip())
        elif tag == 'tr':
            if self.current_row:
                self.table_data.append(self.current_row)
        elif tag == 'table':
            self.in_table = False
            if self.table_data:
                cols = max(len(row) for row in self.table_data)
                tbl = [f'\n#table(\n  columns: {cols},\n  align: left,\n']
                for row in self.table_data:
                    for cell in row:
                        tbl.append(f'  [{cell}],\n')
                tbl.append(')\n\n')
                self.paragraphs.append({
                    'typst': ''.join(tbl),
                    'plain': 'Table',
                    'align': None,
                    'heading': False
                })

    def handle_data(self, data: str):
        if self.in_style:
            self.style_text.append(data)
            return
        if self.in_title:
            self.title_text.append(data)
            return

        self.curr_plain.append(data)

        t = data
        for c in ['#', '$', '@', '[', ']', '*', '<', '>']:
            t = t.replace(c, f'\\{c}')
        t = t.replace('—', ' – ').replace('---', '--')

        if self.in_cell:
            self.cell_content.append(t)
        else:
            self.curr_buf.append(t)

def parse_rtf_to_typst(
    rtf_path: str,
    expected_title: str = None,
    expected_author: str = None,
    expected_date: str = None,
    images: list = None,
    caption_size: str = "6pt",
    title_size: str = "14pt",
    use_initial: bool = True,
    hanging_indent: str = "6mm",
    title_font_spec: str = '("PT Serif", "EB Garamond", "Times New Roman")',
    fmt: str = "br2"
) -> Tuple[str, List[str], str, str, str, List[str], str, bool]:
    """Konvertiert eine RTF- oder RTFD-Datei via textutil deterministisch unter vollständiger Wahrung der Formatierung."""
    res = subprocess.run(
        ["/usr/bin/textutil", "-convert", "html", rtf_path, "-stdout"],
        capture_output=True,
        text=True,
        timeout=30
    )
    if res.returncode != 0:
        raise RuntimeError(f"Fehler bei textutil-Konvertierung von RTF: {res.stderr}")

    base_dir = rtf_path if os.path.isdir(rtf_path) else os.path.dirname(os.path.abspath(rtf_path))
    parser = RTFHTMLToTypstParser(base_dir=base_dir, caption_size=caption_size)
    parser.feed(res.stdout)

    paras = parser.paragraphs
    extracted_title = parser.doc_title
    extracted_author = parser.doc_author
    extracted_date = parser.doc_date if parser.doc_date else expected_date

    # Automatische Erkennung des Titel-Absatzes (z. B. erster Absatz, ALL CAPS, fett oder H1-H3)
    title_idx = None
    title_candidates = [t.lower().strip() for t in [expected_title, extracted_title] if t]
    for idx, p in enumerate(paras[:4]):
        p_plain = p['plain'].strip()
        p_lower = p_plain.lower()
        if any(p_lower == c for c in title_candidates):
            title_idx = idx
            if not extracted_title:
                extracted_title = p_plain
            break
        if idx == 0 and len(p_plain) <= 350 and not p_plain.endswith((".", "!", "?", ";", ":")):
            title_idx = idx
            if not extracted_title:
                extracted_title = p_plain
            break
        if p.get('heading') or (p_plain.isupper() and len(re.findall(r"[A-Za-zÄÖÜäöüß]", p_plain)) >= 3 and len(p_plain) <= 200):
            title_idx = idx
            if not extracted_title:
                extracted_title = p_plain
            break

    typst_blocks = []
    plain_paragraphs = []
    rtf_bib_entries = []
    bib_heading_title = None
    first_body_para_done = False
    heading_2_done = False
    in_bib_section = False
    has_explicit_bib = False
    last_element_was_body_para = False
    bib_header_regex = re.compile(r"^(?:Literaturverzeichnis|Quellenverzeichnis|Works Cited|Bibliography|Literatur|Quellen|References|Library|Referencias|Bibliografía|Fuentes)\b:?\s*$", re.IGNORECASE)

    for idx, p in enumerate(paras):
        prev_was_body_para = last_element_was_body_para
        last_element_was_body_para = False
        content = re.sub(r'\](?=\()', r']\\', p['typst'])
        p_plain_clean = p['plain'].strip()
        plain_paragraphs.append(p['plain'])

        if idx == title_idx:
            t_content = content
            if t_content.startswith("#strong[") and t_content.endswith("]"):
                t_inner = t_content[8:-1]
            else:
                t_inner = t_content
            v_title_gap = "1.8mm" if fmt == "atk1" else "1.4mm"
            typst_blocks.append(f"#align(center)[\n  #par(justify: false)[\n    #text(font: {title_font_spec}, size: {title_size}, weight: \"bold\", fill: rgb(\"#000000\"))[#strong[{t_inner}]]\n  ]\n]\n#v({v_title_gap})")
            continue

        if idx == title_idx + 1 and (is_author_name(p_plain_clean) or p.get('align') == 'center' or p_plain_clean == extracted_author or bool(re.match(r"^(?:autor|author|von|by):\s*", p_plain_clean, re.I))):
            if not extracted_author:
                extracted_author = p_plain_clean
            typst_blocks.append(f"#align(center)[\n  #par(justify: false)[\n    #text(style: \"italic\", weight: \"regular\", fill: rgb(\"#000000\"))[{content}]\n  ]\n]\n#v(1.5mm)")
            continue

        # Literaturverzeichnis-Abschnitt
        words_rtf = p_plain_clean.split()
        is_all_urls_rtf = bool(words_rtf and all(
            w.startswith(("http://", "https://", "doi:", "10.")) or
            w.lower() in ("doi.org", "url:", "quelle:", "quellen:", "links:", "link:", "library:") or
            re.match(r"^https?://", w) or
            re.match(r"^10\.\d{4,9}/", w)
            for w in words_rtf
        ))

        m_bib_rtf = re.match(
            r"^(?:Literaturverzeichnis|Quellenverzeichnis|Works Cited|Bibliography|Literatur|Quellen|References|Library|Referencias|Bibliografía|Fuentes)\b:?\s*(.*)$",
            p_plain_clean,
            re.IGNORECASE
        )
        if m_bib_rtf:
            in_bib_section = True
            has_explicit_bib = True
            first_w_rtf = p_plain_clean.split()[0].rstrip(":").strip()
            if first_w_rtf.isupper() and len(first_w_rtf) > 3:
                bib_heading_title = first_w_rtf.capitalize()
            elif first_w_rtf:
                bib_heading_title = first_w_rtf

            rem_rtf = m_bib_rtf.group(1).strip()
            if rem_rtf and (len(rem_rtf) >= 15 or re.search(r'https?://|\b10\.\d{4,9}/', rem_rtf)):
                rtf_bib_entries.append(rem_rtf)
            continue

        if in_bib_section or is_apa_citation(p_plain_clean) or is_all_urls_rtf:
            if bib_header_regex.match(p_plain_clean):
                continue
            in_bib_section = True
            has_explicit_bib = True
            rtf_bib_entries.append(content)
            continue

        # Zitate in Anführungszeichen immer normal zentrieren
        is_quote = (
            len(p_plain_clean) <= 350 and (
                (p_plain_clean.startswith("»") and p_plain_clean.endswith("«")) or
                (p_plain_clean.startswith("„") and p_plain_clean.endswith("“")) or
                (p_plain_clean.startswith('"') and p_plain_clean.endswith('"')) or
                (p_plain_clean.startswith("“") and p_plain_clean.endswith("”"))
            )
        )
        if is_quote:
            t_content = content
            if not t_content.startswith("#strong["):
                t_content = f"#strong[{t_content}]"
            top_v = "#v(0.8em)\n" if (p.get('has_blank_before') and typst_blocks) else ""
            typst_blocks.append(f"{top_v}#align(center)[\n  #par(justify: false)[\n    #text(fill: rgb(\"#000000\"))[{t_content}]\n  ]\n]\n")
            continue

        # Fette Lead-Überschrift oder explizite Überschriften
        t_trimmed = content.strip()
        is_fully_bold = t_trimmed.startswith("#strong[") and t_trimmed.endswith("]")
        is_lead_heading = (len(typst_blocks) <= 2) and is_fully_bold and len(p_plain_clean) <= 280
        is_section_heading = is_fully_bold and len(p_plain_clean) <= 160

        # Überschriften: Alle einzelnen Sätze oder Phrasen (mit oder ohne Punkt) werden als Überschrift erkannt (Zentriert & Fett)
        is_heading_sentence_rtf = is_heading_sentence(p_plain_clean)

        top_v = "#v(0.8em)\n" if (p.get('has_blank_before') and typst_blocks) else ""

        if p['align'] == 'center':
            typst_blocks.append(f"{top_v}#align(center)[\n  #par(justify: false)[\n    {content}\n  ]\n]")
        elif p['align'] == 'right':
            typst_blocks.append(f"{top_v}#align(right)[\n  #par(justify: false)[\n    {content}\n  ]\n]")
        elif p['heading'] or is_section_heading or is_heading_sentence_rtf or is_lead_heading:
            inner_c = t_trimmed[8:-1] if is_fully_bold else content
            typst_blocks.append(f"{top_v}#align(center)[\n  #par(justify: false)[\n    #strong[{inner_c}]\n  ]\n]\n")
        else:
            if use_initial and not first_body_para_done:
                content_init = apply_initial_to_typst_element(content, font_spec=title_font_spec)
                if top_v:
                    content_init = f"{top_v}{content_init}"
                typst_blocks.append(content_init)
            else:
                if p.get('has_indent'):
                    content = f"#h(3.8mm){content}"
                if top_v:
                    content = f"{top_v}{content}"
                typst_blocks.append(content)
            first_body_para_done = True

    # Falls Bilder über -i übergeben wurden, diese am Ende anhängen
    if images:
        for img_p in images:
            if os.path.exists(img_p):
                typst_blocks.append(format_figure_typst(img_p, caption_size=caption_size))

    doc_has_indents_rtf = any(p.get('has_indent', False) for p in paras)

    full_plain_text = "\n\n".join(plain_paragraphs)
    extracted_urls = parser.urls + extract_urls_from_text(full_plain_text)
    unique_urls = []
    seen_urls = set()
    for u in extracted_urls:
        if u and u not in seen_urls:
            seen_urls.add(u)
            unique_urls.append(u)

    return "\n\n".join(typst_blocks), unique_urls, extracted_title, extracted_author, extracted_date, rtf_bib_entries, bib_heading_title, doc_has_indents_rtf

def clean_title_and_author(title: str, author: str = None, fallback_author: str = None):
    """Bereinigt Titel und Autor deterministisch von redundanten Namensdopplungen und korrigiert Inversionen."""
    final_author = author.strip() if (author and author.strip()) else fallback_author
    if not title:
        return "", final_author

    cleaned_title = title.strip()

    # Inversions-Korrektur: Falls Titel fälschlicherweise ein Personenname ist und Autor eine Überschrift/Titel
    if cleaned_title and is_author_name(cleaned_title) and (not final_author or not is_author_name(final_author)):
        cleaned_title, final_author = (final_author if final_author else ""), cleaned_title

    # Bereinige führende Dokumenttyp-Präfixe aus dem Titel (z. B. "Artikel : Wer schwitzt..." -> "Wer schwitzt...")
    m_pref = re.match(r"^(?:artikel|aufsatz|bericht|essay|notizen?|entwurf|text|dokument|paper|report|article)\s*[:|]\s*(.+)$", cleaned_title, re.IGNORECASE)
    if m_pref:
        cleaned_title = m_pref.group(1).strip()

    authors_to_check = [a for a in [final_author, "Jonathan Klatchko", "Yona Klatchko"] if a]
    seen = set()
    unique_authors = [a for a in authors_to_check if a and not (a in seen or seen.add(a))]

    for a in unique_authors:
        pat_end = re.compile(
            r"[\s\-_–—|:]*(?:(?:von|by|autor|author)\s+)?[\s\-_–—|:]*" + re.escape(a) + r"\s*$",
            re.IGNORECASE
        )
        if pat_end.search(cleaned_title):
            if not final_author:
                final_author = a
            cleaned_title = pat_end.sub("", cleaned_title)

        pat_mid = re.compile(
            r"[\s\-_–—|:]+(?:(?:von|by|autor|author)\s+)?" + re.escape(a) + r"[\s\-_–—|:]+",
            re.IGNORECASE
        )
        cleaned_title = pat_mid.sub(" ", cleaned_title)

    # Prüfe auch Trenner am Titelende nach unbekannten Autoren
    m_sep = re.search(r"^(.*?)\s*(?:[:|]|\s[-–—]\s|(?:,\s*)?\b(?:von|by|autor|author)\b)\s*(.+)$", cleaned_title, re.IGNORECASE)
    if m_sep:
        t_cand, a_cand = m_sep.group(1).strip(), m_sep.group(2).strip()
        if is_author_name(a_cand):
            cleaned_title = t_cand
            if not final_author:
                final_author = a_cand
        elif is_author_name(t_cand):
            cleaned_title = a_cand
            if not final_author:
                final_author = t_cand

    cleaned_title = re.sub(r"[\s\-_–—|:]+$", "", cleaned_title).strip()
    if not cleaned_title:
        cleaned_title = title.strip()

    return cleaned_title, final_author

def extract_metadata_and_body(raw_text: str, default_author: str = None, default_date: str = None, known_title: str = None):
    """Trennt Dokumenttitel, Autor, Datum und den eigentlichen Textkörper deterministisch."""
    lines = raw_text.splitlines()
    start_idx = 0
    while start_idx < len(lines) and not lines[start_idx].strip():
        start_idx += 1

    extracted_title = None
    extracted_author = None
    extracted_date = default_date
    curr_idx = start_idx

    date_regexes = [re.compile(p, re.IGNORECASE) for p in DATE_PATTERNS]

    # Untersuche die ersten nicht-leeren Zeilen im Dokumentkopf
    while curr_idx < len(lines) and curr_idx < start_idx + 8:
        line_s = lines[curr_idx].strip()
        if not line_s:
            curr_idx += 1
            continue

        # 1. Expliziter Titel-Präfix (z. B. "Titel: ...", "Title: ...")
        m_t_prefix = re.match(r"^(?:Titel|Title|Thema|Subject):\s*(.+)$", line_s, re.IGNORECASE)
        if m_t_prefix:
            if not extracted_title:
                extracted_title = m_t_prefix.group(1).strip()
            curr_idx += 1
            continue

        # 2. Expliziter Markdown-Titel (# Titel)
        if line_s.startswith("# ") and not line_s.startswith("##"):
            cand = line_s[2:].strip()
            if not known_title or is_matching_title(cand, known_title):
                if not extracted_title:
                    extracted_title = cand
                curr_idx += 1
                continue
            else:
                # Nicht als Dokumenttitel konsumieren, falls ein anderer Dokumenttitel vorgegeben ist
                break

        # 3. Expliziter Autor-Präfix
        m_auth = re.match(r"^(?:Autor|Author|Von|By|Verfasser|Written\s+by):\s*(.+)$", line_s, re.IGNORECASE)
        if m_auth:
            if not extracted_author:
                extracted_author = m_auth.group(1).strip()
            curr_idx += 1
            continue

        # 4. Datum
        is_dt = False
        for d_reg in date_regexes:
            m_d = d_reg.match(line_s)
            if m_d:
                if not extracted_date:
                    extracted_date = m_d.group(1).strip() if m_d.groups() else line_s
                curr_idx += 1
                is_dt = True
                break
        if is_dt:
            continue

        # 5. Titel ohne Markdown-Syntax / Präfix
        # WICHTIG: Wenn known_title bereits vorliegt (Dateiname oder CLI -t), darf eine beliebige
        # Inhaltszeile NIEMALS als Titel abgeschnitten werden! Sie ist Teil des Textkörpers (Überschrift 1 / 2).
        # Nur wenn sie semantisch exakt mit known_title übereinstimmt, ist sie eine redundante Titeldopplung im Kopf.
        if not extracted_title:
            if known_title:
                if is_matching_title(line_s, known_title):
                    extracted_title = line_s
                    curr_idx += 1
                    continue
            else:
                # Kein known_title vorhanden: Nur wenn unmittelbar danach ein Autor oder Datum folgt,
                # kann eine kurze Zeile ohne Punkt als Titel im Kopf gewertet werden.
                # Andernfalls bleibt sie Textinhalt!
                has_subsequent_metadata = False
                for check_i in range(curr_idx + 1, min(curr_idx + 4, len(lines))):
                    next_s = lines[check_i].strip()
                    if next_s and (is_author_name(next_s) or any(d_reg.match(next_s) for d_reg in date_regexes)):
                        has_subsequent_metadata = True
                        break
                if has_subsequent_metadata and len(line_s) <= 200 and not line_s.endswith((".", "!", "?")) and not line_s.startswith(("-", "*", "•", "##", ">")):
                    if not is_author_name(line_s):
                        extracted_title = line_s
                        curr_idx += 1
                        continue

        # 6. Autor ohne Präfix (z. B. "Jonathan Klatchko")
        if is_author_name(line_s):
            if not extracted_author:
                extracted_author = line_s
                curr_idx += 1
                continue

        # Sobald eine Zeile weder Titel, Autor noch Datum ist, beginnt der eigentliche Fließtext
        break

    # Überspringe alle Leerzeilen nach dem Kopfbereich
    while curr_idx < len(lines) and not lines[curr_idx].strip():
        curr_idx += 1

    clean_body_lines = lines[curr_idx:]

    # Sicherheits-Korrektur: Falls Titel ein Autor ist
    if extracted_title and is_author_name(extracted_title) and (not extracted_author or not is_author_name(extracted_author)):
        extracted_title, extracted_author = (extracted_author if extracted_author else None), extracted_title

    final_author = extracted_author if extracted_author else default_author
    final_date = extracted_date if extracted_date else default_date
    return extracted_title, final_author, final_date, clean_body_lines

def convert_txt_to_apa_standalone(
    input_path: str,
    output_path: str = None,
    title: str = None,
    author: str = None,
    date: str = None,
    institution: str = "California Lutheran University",
    course: str = None,
    instructor: str = None,
    open_preview: bool = False
) -> bool:
    """Eigenständiger, vollautonomer Typst-Kompilierer für das APA 7th Edition Student Paper Format."""
    abs_input = os.path.abspath(input_path)
    base_name = os.path.splitext(os.path.basename(abs_input))[0]
    if output_path is None:
        abs_output = os.path.join(os.path.dirname(abs_input), f"{base_name}.pdf")
    else:
        abs_output = os.path.abspath(output_path)

    os.makedirs(os.path.dirname(abs_output), exist_ok=True)

    with open(abs_input, "r", encoding="utf-8", errors="replace") as f:
        raw_content = f.read()

    file_title, file_author = parse_title_author_from_filename(base_name)
    known_title = title or file_title
    ext_title, ext_author, ext_date, body_lines = extract_metadata_and_body(
        raw_content, default_author=author, default_date=date, known_title=known_title
    )

    doc_title = title or file_title or ext_title or base_name
    doc_author = author or file_author or ext_author or "Jonathan Klatchko"
    doc_date = date or ext_date or time.strftime("%B %d, %Y")

    doc_title, doc_author = clean_title_and_author(doc_title, doc_author, fallback_author=file_author)

    if ext_title and not is_matching_title(ext_title, doc_title):
        body_lines = [ext_title, ""] + list(body_lines)

    paragraphs = []
    cur = []
    bib_re_standalone = re.compile(r"^(?:Quellen|Literatur|Literaturverzeichnis|References|Quellenverzeichnis|Works Cited|Bibliography|Library|Referencias|Bibliografía|Fuentes):?\s*$", re.I)
    bib_re_prefix = re.compile(r"^(Quellen|Literatur|Literaturverzeichnis|References|Quellenverzeichnis|Works Cited|Bibliography|Library|Referencias|Bibliografía|Fuentes):?\s+(.+)$", re.I)

    for l in body_lines:
        s = l.strip()
        if not s:
            if cur:
                paragraphs.append("\n".join(cur))
                cur = []
            continue

        if bib_re_standalone.match(s):
            if cur:
                paragraphs.append("\n".join(cur))
                cur = []
            paragraphs.append(s)
            continue

        m_bp = bib_re_prefix.match(s)
        if m_bp:
            if cur:
                paragraphs.append("\n".join(cur))
                cur = []
            paragraphs.append(m_bp.group(1).strip())
            rest_bp = m_bp.group(2).strip()
            if rest_bp:
                paragraphs.append(rest_bp)
            continue

        cur.append(s)

    if cur:
        paragraphs.append("\n".join(cur))

    elements = []
    bib_entries = []
    in_bib = False

    for para in paragraphs:
        lines_in_para = para.splitlines()
        flat = " ".join(l.strip() for l in lines_in_para).strip()

        words_f = flat.split()
        is_all_urls = bool(words_f and all(
            w.startswith(("http://", "https://", "doi:", "10.")) or
            w.lower() in ("doi.org", "url:", "quelle:", "quellen:", "library:") or
            re.match(r"^https?://", w) or
            re.match(r"^10\.\d{4,9}/", w)
            for w in words_f
        ))

        m_bib_header = re.match(r"^(?:Quellen|Literatur|Literaturverzeichnis|References|Quellenverzeichnis|Works Cited|Bibliography|Library|Referencias|Bibliografía|Fuentes):?\s*(.*)$", flat, re.I)
        if m_bib_header:
            in_bib = True
            rem_bib = m_bib_header.group(1).strip()
            if rem_bib:
                cit_data = format_citation_to_apa_7(rem_bib, context_text=raw_content)
                if cit_data and cit_data.get("formatted"):
                    bib_entries.append(f"#block(spacing: 1.2em)[\n  #set par(hanging-indent: 12.7mm, first-line-indent: 0pt, justify: false)\n  {cit_data['formatted']}\n]")
                else:
                    esc_cite = format_content_to_typst(rem_bib)
                    bib_entries.append(f"#block(spacing: 1.2em)[\n  #set par(hanging-indent: 12.7mm, first-line-indent: 0pt, justify: false)\n  {esc_cite}\n]")
            continue

        if in_bib or is_apa_citation(flat) or is_all_urls:
            in_bib = True
            # Falls mehrere URLs im Absatz vorhanden sind, jede einzeln formatieren
            urls_in_para = re.findall(r"https?://[^\s<>\"\'\[\]]+|\bdoi:\s*10\.\d{4,9}/[^\s<>\"\'\[\]]+|\b10\.\d{4,9}/[^\s<>\"\'\[\]]+", flat)
            if urls_in_para and (len(urls_in_para) > 1 or is_all_urls):
                for single_u in urls_in_para:
                    cit_data = format_citation_to_apa_7(single_u.strip(), context_text=raw_content)
                    if cit_data and cit_data.get("formatted"):
                        bib_entries.append(f"#block(spacing: 1.2em)[\n  #set par(hanging-indent: 12.7mm, first-line-indent: 0pt, justify: false)\n  {cit_data['formatted']}\n]")
                    else:
                        esc_cite = format_content_to_typst(single_u.strip())
                        bib_entries.append(f"#block(spacing: 1.2em)[\n  #set par(hanging-indent: 12.7mm, first-line-indent: 0pt, justify: false)\n  {esc_cite}\n]")
            else:
                cit_data = format_citation_to_apa_7(flat, context_text=raw_content)
                if cit_data and cit_data.get("formatted"):
                    bib_entries.append(f"#block(spacing: 1.2em)[\n  #set par(hanging-indent: 12.7mm, first-line-indent: 0pt, justify: false)\n  {cit_data['formatted']}\n]")
                else:
                    esc_cite = format_content_to_typst(flat)
                    bib_entries.append(f"#block(spacing: 1.2em)[\n  #set par(hanging-indent: 12.7mm, first-line-indent: 0pt, justify: false)\n  {esc_cite}\n]")
            continue

        is_h = (not flat.endswith((".", "...", ";")) and len(flat) <= 300 and len(lines_in_para) <= 3 and
                not any(flat.lower().startswith(w) for w in ["und ", "oder ", "aber ", "denn ", "weil ", "dass ", "wenn ", "obwohl "]))

        if flat.startswith("# ") or (flat.isupper() and len(flat) <= 120):
            esc_h = format_content_to_typst(re.sub(r"^#+\s*", "", flat))
            elements.append(f"\n#align(center)[#text(weight: \"bold\")[{esc_h}]]\n")
        elif is_h or flat.startswith("## "):
            esc_h = format_content_to_typst(re.sub(r"^#+\s*", "", flat))
            elements.append(f"\n#text(weight: \"bold\")[{esc_h}]\n")
        else:
            esc_p = format_content_to_typst(flat)
            elements.append(f"{esc_p}\n")

    apa_body = "\n".join(elements)

    apa_refs = ""
    if bib_entries:
        apa_refs = f"""
#pagebreak()
#align(center)[#text(weight: "bold")[References]]
#v(1.2em)

{"".join(bib_entries)}
"""

    course_line = f"  #text()[{escape_typst_line(course)}]\n" if course else ""
    inst_line = f"  #text()[{escape_typst_line(instructor)}]\n" if instructor else ""

    typst_apa = f"""#show link: set text(fill: rgb("#0b57d0"))
#set page(
  paper: "us-letter",
  margin: (x: 25.4mm, top: 25.4mm, bottom: 25.4mm),
  header: context [
    #align(right)[#text(font: ("Times New Roman", "Times", "PT Serif", "serif"), size: 12pt)[#counter(page).display()]]
  ]
)
#set text(
  font: ("Times New Roman", "Times", "PT Serif", "serif"),
  size: 12pt,
  lang: "en"
)
#set par(
  justify: false,
  leading: 1.15em,
  first-line-indent: 12.7mm
)

// APA 7 Student Title Page (Seite 1)
#v(72pt)
#align(center)[
  #text(weight: "bold")[{escape_typst_line(doc_title)}]
  #v(24pt)
  #text()[{escape_typst_line(doc_author)}]
  #linebreak()
  #text()[{escape_typst_line(institution)}]
{course_line}{inst_line}  #linebreak()
  #text()[{escape_typst_line(doc_date)}]
]

#pagebreak()

// Seite 2: Beginn des Aufsatzes mit zentriertem Titel
#align(center)[
  #text(weight: "bold")[{escape_typst_line(doc_title)}]
]
#v(1.2em)

{apa_body}
{apa_refs}
"""
    tmp_typ = f"{abs_output}.tmp_{os.getpid()}_{int(time.time()*1000)}.typ"
    try:
        with open(tmp_typ, "w", encoding="utf-8") as f:
            f.write(typst_apa)

        cmd = [TYPST_BIN, "compile", "--root", "/", tmp_typ, abs_output]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60)
    finally:
        if os.path.exists(tmp_typ):
            try:
                os.remove(tmp_typ)
            except OSError:
                pass

    if res.returncode == 0 and os.path.exists(abs_output) and os.path.getsize(abs_output) > 0:
        print(f"Erfolg: PDF erzeugt -> {abs_output}")
        if open_preview:
            subprocess.run(["open", abs_output], timeout=60)
        return True
    else:
        print(f"Fehler bei APA-Kompilierung:\n{res.stderr}", file=sys.stderr)
        return False

def translate_via_deepl(text: str, target_lang: str = "en", source_lang: str = "auto") -> str:
    """Übersetzt Text via DeepL unter Nutzung der deepl-Bibliothek oder deepl_translate_engine."""
    if not text or not text.strip():
        return text

    # 1. Versuche deepl_translate_engine
    try:
        config_scripts = os.path.expanduser("~/.gemini/config/scripts")
        if config_scripts not in sys.path:
            sys.path.insert(0, config_scripts)
        from deepl_translate_engine import translate_text
        return translate_text(text, source_lang=source_lang, target_lang=target_lang)
    except Exception:
        pass

    # 2. Direktes deepl SDK
    try:
        import deepl
        auth_key = os.environ.get("DEEPL_AUTH_KEY") or os.environ.get("DEEPL_API_KEY")
        if not auth_key:
            for p in (os.path.expanduser("~/.gemini/config/deepl.key"), os.path.expanduser("~/.config/deepl/key")):
                if os.path.exists(p):
                    with open(p, "r", encoding="utf-8") as f:
                        auth_key = f.read().strip()
                        if auth_key:
                            break
        if auth_key:
            translator = deepl.Translator(auth_key)
            norm_tgt = target_lang.upper().strip()
            if norm_tgt == "EN":
                norm_tgt = "EN-US"
            res = translator.translate_text(text, target_lang=norm_tgt)
            return res.text if hasattr(res, "text") else str(res)
    except Exception as e:
        print(f"DeepL SDK Warnung: {e}", file=sys.stderr)

    print(
        "Hinweis: Für DeepL-Übersetzungen bitte 'pip install deepl' ausführen und DEEPL_AUTH_KEY setzen.",
        file=sys.stderr
    )
    return text

def convert_txt_to_pdf(
    input_path: str,
    output_path: str = None,
    title: str = None,
    author: str = None,
    date: str = None,
    lang: str = "de",
    font_size: str = None,
    leading: str = None,
    gutter: str = None,
    images: List[str] = None,
    font: str = None,
    open_preview: bool = False,
    columns: int = None,
    font_family: str = None,
    format_preset: str = "atk2",
    use_initial: bool = None,
    target_lang: str = None,
    margins: str = None
) -> bool:
    if not os.path.exists(input_path):
        print(f"Fehler: Datei nicht existent: {input_path}", file=sys.stderr)
        return False

    abs_input = os.path.abspath(input_path)
    base_name = os.path.splitext(os.path.basename(abs_input))[0]
    
    # Universelle Invariante: Ausnahmslos genau EINE Datei im gleichen Ordner der Ursprungsdatei
    if output_path is None:
        abs_output = os.path.join(os.path.dirname(abs_input), f"{base_name}.pdf")
    else:
        abs_output = os.path.abspath(output_path)

    os.makedirs(os.path.dirname(abs_output), exist_ok=True)

    # Format-Profil auflösen (-f atk | br2 | br1 | apa; Standard: atk)
    fmt_raw = (format_preset or "atk").lower().strip()
    if fmt_raw in ("atk", "artikel", "atk2", "atk1", "artikel1", "artikel2"):
        fmt = "atk"
    elif fmt_raw in ("br1", "bericht1"):
        fmt = "br1"
    elif fmt_raw == "apa":
        fmt = "apa"
    else:
        fmt = "br2"

    if fmt == "apa":
        try:
            config_scripts = os.path.expanduser("~/.gemini/config/scripts")
            if config_scripts not in sys.path:
                sys.path.insert(0, config_scripts)
            from apa_essay_compiler import convert_apa_to_pdf
            res_dict = convert_apa_to_pdf(
                input_source=abs_input,
                output_pdf=output_path,
                title_override=title,
                author_override=author,
                date_override=date,
                course_override=None,
                deep_research=False,
                preview=open_preview
            )
            out_p = res_dict.get("pdf") if isinstance(res_dict, dict) else None
            if out_p and os.path.exists(out_p):
                return True
        except Exception:
            pass
        return convert_txt_to_apa_standalone(
            input_path=abs_input,
            output_path=output_path,
            title=title,
            author=author,
            date=date,
            open_preview=open_preview
        )

    if fmt == "atk":
        final_columns = columns if columns is not None else 3
        final_initial = use_initial if use_initial is not None else True
        final_gutter = gutter if gutter is not None else "4.8mm"
        final_font_size = font_size if font_size is not None else "10pt"
        default_leading = "0.35em"
    elif fmt == "br1":
        final_columns = columns if columns is not None else 1
        final_initial = use_initial if use_initial is not None else False
        final_gutter = gutter if gutter is not None else "0mm"
        final_font_size = font_size if font_size is not None else "12pt"
        default_leading = "0.35em"
    else:  # br2 (Standard: 2 Spalten, 12pt Textgröße, Optima)
        final_columns = columns if columns is not None else 2
        final_initial = use_initial if use_initial is not None else False
        final_gutter = gutter if gutter is not None else "5.2mm"
        final_font_size = font_size if font_size is not None else "12pt"
        default_leading = "0.35em"

    if leading is not None:
        s_lead = str(leading).strip()
        m_num = re.match(r"^([0-9.]+)(em|pt|mm)?$", s_lead)
        if m_num:
            val = float(m_num.group(1))
            unit = m_num.group(2)
            if not unit:
                # Numerischer Faktor: 1.0 entspricht Basis 0.35em, 0.8 entspricht 0.28em
                final_leading = f"{val * 0.35:g}em" if val <= 2.5 else f"{val}pt"
            else:
                final_leading = f"{val:g}{unit}"
        else:
            final_leading = s_lead
    else:
        final_leading = default_leading

    # Automatische Extraktion aus Dateinamen (z. B. "Titel : Autor" oder "Titel - Autor")
    file_title_candidate, file_author_candidate = parse_title_author_from_filename(base_name)

    is_rtfd = abs_input.lower().endswith(".rtfd")
    is_rtf = is_rtfd or abs_input.lower().endswith(".rtf")

    # Dynamische Schriftgrößen: 6pt bis 12pt (Hauptüberschrift bei atk: 36pt, sonst +6pt, Bildunterschriften -2pt)
    m = re.search(r"([\d.]+)", str(final_font_size))
    raw_pt = float(m.group(1)) if m else (10.0 if fmt == "atk" else 12.0)
    base_pt = max(6.0, min(raw_pt, 12.0))
    final_font_size = f"{base_pt:g}pt"
    if fmt == "atk":
        title_size = "36pt"
    else:
        title_size = f"{base_pt + 6.0:g}pt"
    caption_size = f"{max(base_pt - 2.0, 3.0):g}pt"
    hanging_indent = "12.7mm" if final_columns == 1 else "6mm"

    # Typografische Schriftartauflösung via -z oder Format-Standard
    selected_font = font if font is not None else font_family
    body_font_spec, chosen_font_name = resolve_font_spec(selected_font, fmt)
    title_font_spec = resolve_title_font_spec(fmt, body_font_spec)

    if is_rtf:
        body_text, urls, rtf_title, rtf_author, rtf_date, explicit_bib_entries, bib_heading_title, doc_has_indents = parse_rtf_to_typst(
            abs_input,
            expected_title=title or file_title_candidate,
            expected_author=author or file_author_candidate,
            expected_date=date,
            images=images,
            caption_size=caption_size,
            title_size=title_size,
            use_initial=final_initial,
            hanging_indent=hanging_indent,
            title_font_spec=title_font_spec,
            fmt=fmt
        )
        extracted_title = rtf_title if rtf_title else None
        extracted_author = rtf_author if rtf_author else None
        extracted_date = rtf_date if rtf_date else date
    else:
        with open(abs_input, "r", encoding="utf-8", errors="replace") as f:
            raw_content = f.read()

        doc_dir = os.path.dirname(abs_input)
        known_title = title or file_title_candidate
        extracted_title, extracted_author, extracted_date, body_lines = extract_metadata_and_body(
            raw_content, default_author=author, default_date=date, known_title=known_title
        )

        raw_title = title if title else (file_title_candidate if file_title_candidate else (extracted_title if extracted_title else base_name))
        target_author = author if author else (file_author_candidate if file_author_candidate else extracted_author)
        doc_date = date if date else extracted_date

        # Single-Occurrence Invariante
        doc_title, doc_author = clean_title_and_author(raw_title, target_author, fallback_author=file_author_candidate)

        # Sicherheits-Invariante: Falls extracted_title vorliegt, dieser aber nicht dem Haupttitel entspricht,
        # darf er keinesfalls verloren gehen, sondern muss als Inhaltszeile (Überschrift) im Textkörper verbleiben!
        if extracted_title and not is_matching_title(extracted_title, doc_title):
            body_lines = [extracted_title, ""] + list(body_lines)

        if target_lang:
            trans_tgt = target_lang.lower().strip()
            # Titel und Autorüberschrift übersetzen falls zutreffend
            if doc_title:
                doc_title = translate_via_deepl(doc_title, target_lang=trans_tgt)
            if file_title_candidate:
                file_title_candidate = translate_via_deepl(file_title_candidate, target_lang=trans_tgt)

            # Body-Lines absatzweise übersetzen (Bilder ##, URLs und Quellenüberschriften schonen)
            translated_body = []
            curr_chunk = []
            for line in body_lines:
                s_line = line.strip()
                if s_line.startswith("##") or s_line.startswith("http://") or s_line.startswith("https://") or s_line.startswith("doi.org"):
                    if curr_chunk:
                        chunk_text = "\n".join(curr_chunk)
                        translated_body.extend(translate_via_deepl(chunk_text, target_lang=trans_tgt).split("\n"))
                        curr_chunk = []
                    translated_body.append(line)
                elif re.match(r"^(?:LITERATURVERZEICHNIS|QUELLEN|REFERENCES|LITERATURE|REFERENCIAS|BIBLIOGRAFÍA|FUENTES)\b", s_line, re.I):
                    if curr_chunk:
                        chunk_text = "\n".join(curr_chunk)
                        translated_body.extend(translate_via_deepl(chunk_text, target_lang=trans_tgt).split("\n"))
                        curr_chunk = []
                    if trans_tgt == "en":
                        hdr = "REFERENCES"
                    elif trans_tgt == "es":
                        hdr = "REFERENCIAS"
                    else:
                        hdr = "LITERATURVERZEICHNIS"
                    translated_body.append(hdr)
                elif not s_line:
                    if curr_chunk:
                        chunk_text = "\n".join(curr_chunk)
                        translated_body.extend(translate_via_deepl(chunk_text, target_lang=trans_tgt).split("\n"))
                        curr_chunk = []
                    translated_body.append("")
                else:
                    curr_chunk.append(line)
            if curr_chunk:
                chunk_text = "\n".join(curr_chunk)
                translated_body.extend(translate_via_deepl(chunk_text, target_lang=trans_tgt).split("\n"))
            body_lines = translated_body

        body_text, urls, explicit_bib_entries, bib_heading_title, doc_has_indents = parse_body_to_typst(
            body_lines, images=images, caption_size=caption_size, use_initial=final_initial, doc_dir=doc_dir, hanging_indent=hanging_indent, title_font_spec=title_font_spec
        )

    if is_rtf:
        raw_title = title if title else (file_title_candidate if file_title_candidate else (extracted_title if extracted_title else base_name))
        target_author = author if author else (file_author_candidate if file_author_candidate else extracted_author)
        doc_date = date if date else extracted_date
        doc_title, doc_author = clean_title_and_author(raw_title, target_author, fallback_author=file_author_candidate)

    # Ränder-Auflösung (-r k | m | g bzw. klein | mittel | groß)
    # Standard: 'k' (klein) bei atk, 'm' (mittel) bei br2, br1; entfällt bei APA (25.4mm)
    if fmt == "atk":
        default_margin_x = "10mm"
        default_margin_y = "12mm"
        default_content_w = 190
    else:
        default_margin_x = "16mm"
        default_margin_y = "18mm"
        default_content_w = 178

    margin_x = default_margin_x
    margin_y = default_margin_y
    content_w_val = default_content_w

    if margins is not None:
        m_raw = str(margins).lower().strip()
        if m_raw in ("k", "klein", "small"):
            margin_x = "10mm"
            margin_y = "12mm"
            content_w_val = 190
        elif m_raw in ("g", "gross", "groß", "large"):
            margin_x = "22mm"
            margin_y = "24mm"
            content_w_val = 166
        elif m_raw in ("m", "mittel", "medium", "standard"):
            margin_x = "16mm"
            margin_y = "18mm"
            content_w_val = 178
        else:
            # Direkte Maßangabe (z. B. 12mm)
            m_custom = re.match(r"^([0-9.]+)(mm|cm|pt|in)$", m_raw)
            if m_custom:
                dim_val = float(m_custom.group(1))
                dim_unit = m_custom.group(2)
                margin_x = f"{dim_val:g}{dim_unit}"
                margin_y = f"{dim_val:g}{dim_unit}"
                if dim_unit == "mm":
                    content_w_val = max(100, int(210 - 2 * dim_val))
                elif dim_unit == "cm":
                    content_w_val = max(100, int(210 - 2 * dim_val * 10))
                else:
                    content_w_val = 178

    # Begrenzung der Titelbreite auf exakt 85% der Satzspiegelbreite (Textbreite)
    max_title_w_val = round(content_w_val * 0.85, 1)

    effective_lang = target_lang.lower().strip() if target_lang else lang
    if not target_lang and lang == "de" and 'raw_content' in locals() and raw_content:
        words_sample = re.findall(r"\b[A-Za-zÀ-ÿ]+\b", raw_content.lower())
        en_stop = {"the", "and", "in", "of", "to", "with", "is", "that", "for", "on", "as", "by", "this", "from"}
        es_stop = {"el", "la", "los", "las", "un", "una", "de", "en", "y", "que", "por", "para", "con", "del", "al"}
        de_stop = {"der", "die", "das", "und", "in", "von", "zu", "mit", "ist", "dass", "für", "auf", "als"}
        en_count = sum(1 for w in words_sample if w in en_stop)
        es_count = sum(1 for w in words_sample if w in es_stop)
        de_count = sum(1 for w in words_sample if w in de_stop)
        if es_count > de_count and es_count > en_count and es_count >= 10:
            effective_lang = "es"
        elif en_count > de_count and en_count >= 10:
            effective_lang = "en"

    if effective_lang == "es":
        default_bib_title = "Referencias"
        page_label = "Página"
        of_label = "de"
        author_prefix = "POR "
    elif effective_lang == "en":
        default_bib_title = "References"
        page_label = "Page"
        of_label = "of"
        author_prefix = "BY "
    else:
        default_bib_title = "Literaturverzeichnis"
        page_label = "Seite"
        of_label = "von"
        author_prefix = "VON "

    final_bib_title = bib_heading_title if bib_heading_title else default_bib_title

    raw_doc_context = raw_content if not is_rtf else " ".join(plain_paragraphs if 'plain_paragraphs' in locals() else [])
    bib_title_size = f"{base_pt + 4.0:g}pt"

    bibliography_typst = generate_bibliography_typst(
        urls=urls,
        explicit_entries=explicit_bib_entries,
        bib_title=final_bib_title,
        font_spec=body_font_spec,
        font_size=final_font_size,
        title_size=bib_title_size,
        context_text=raw_doc_context,
        hanging_indent=hanging_indent,
        leading=final_leading,
        use_body_indent=doc_has_indents
    )

    columns_directive = f"#set columns(gutter: {final_gutter})\n" if final_columns > 1 else ""

    if fmt == "atk":
        author_font_spec = '("Calibre", "Helvetica Neue", "Helvetica", "Arial", "Roboto", "sans-serif")'
        if doc_author:
            clean_a = doc_author.strip()
            if not any(clean_a.upper().startswith(p) for p in ("VON ", "BY ", "POR ")):
                clean_a = f"{author_prefix}{clean_a}"
            author_text = clean_a.upper()
        else:
            author_text = ""
        author_part = f'\n        #v(5.5mm)\n        #block[#text(font: {author_font_spec}, size: 8.5pt, weight: "regular", tracking: 0.08em, fill: rgb("#000000"))[{escape_typst_line(author_text)}]]' if doc_author else ""
        date_part = f'\n        #v(1.0mm)\n        #block[#text(font: {author_font_spec}, size: 7.5pt, fill: rgb("#000000"))[{escape_typst_line(doc_date)}]]' if doc_date else ""
        top_header_box = f"""// Vollbreite-Titelbox mit Trennlinie (atk: Didot maximal dynamisch, einzeilig, zentriert)
#place(top, scope: "parent", float: true)[
  #block(width: 100%, inset: (bottom: 2.5mm))[
    #context {{
      let max-w = {max_title_w_val}mm
      let low = 10.0
      let high = 120.0
      for _ in range(16) {{
        let mid = (low + high) / 2.0
        let m = measure(text(font: {title_font_spec}, size: mid * 1pt, weight: "bold")[#strong[{escape_typst_line(doc_title)}]])
        if m.width <= max-w {{
          low = mid
        }} else {{
          high = mid
        }}
      }}
      let best-sz = low * 1pt
      align(center)[
        #block[#text(font: {title_font_spec}, size: best-sz, weight: "bold", fill: rgb("#000000"))[#strong[{escape_typst_line(doc_title)}]]]{author_part}{date_part}
      ]
    }}
    #v(1.8mm)
    #line(length: 100%, stroke: 0.3pt + rgb("#000000"))
  ]
]
"""
    else:
        author_block = ""
        if doc_author:
            clean_a = doc_author.strip()
            if not any(clean_a.lower().startswith(p.lower()) for p in ("von ", "by ", "por ")):
                clean_a = f"{author_prefix.lower()}{clean_a}"
            author_block = f'\n        #v(1.4mm)\n        #block[#text(style: "italic", weight: "regular", fill: rgb("#000000"))[{escape_typst_line(clean_a)}]]'

        if doc_date:
            header_content = f"""#grid(
      columns: (1fr, auto),
      gutter: 6mm,
      align: (left + horizon, right + horizon),
      [
        #block[#text(font: {title_font_spec}, size: {title_size}, weight: "bold", fill: rgb("#000000"))[#strong[{escape_typst_line(doc_title)}]]]{author_block}
      ],
      [
        #text(fill: rgb("#000000"))[{escape_typst_line(doc_date)}]
      ]
    )"""
        else:
            header_content = f"""#align(left)[
      #block[#text(font: {title_font_spec}, size: {title_size}, weight: "bold", fill: rgb("#000000"))[#strong[{escape_typst_line(doc_title)}]]]{author_block}
    ]"""

        top_header_box = f"""// Vollbreite-Titelbox mit Trennlinie (Titel dynamisch: Textgröße + 6pt)
#place(top, scope: "parent", float: true)[
  #block(width: 100%, inset: (bottom: 2.5mm))[
    {header_content}
    #v(1.2mm)
    #line(length: 100%, stroke: 0.3pt + rgb("#000000"))
  ]
]
"""

    header_directive = "  header: none,"

    if is_rtf:
        top_header_box = ""

    # Druckbare DIN-A4-Geometrie mit dynamischen Rändern (-r k | m | g)
    # Seitennummern nur bei mehrseitigen Dokumenten (total_pages > 1)
    typst_template = f"""#import "@preview/droplet:0.3.1": dropcap

#show link: set text(fill: rgb("#000000"))

#set page(
  paper: "a4",
  margin: (x: {margin_x}, top: {margin_y}, bottom: {margin_y}),
  columns: {final_columns},
{header_directive}
  footer: context {{
    let page_num = counter(page).get().first()
    let total_pages = counter(page).final().first()
    if total_pages > 1 [
      #align(center)[
        #text(size: 8.5pt, fill: rgb("#000000"))[{page_label} #page_num {of_label} #total_pages]
      ]
    ]
  }}
)

{columns_directive}#set text(
  font: {body_font_spec},
  size: {final_font_size},
  lang: "{effective_lang}",
  hyphenate: true,
  costs: (hyphenation: 2000%)
)

#set par(
  justify: true,
  leading: {final_leading},
  spacing: {final_leading},
  first-line-indent: 0pt,
  linebreaks: "optimized"
)

{top_header_box}
{body_text}

{bibliography_typst}
"""

    tmp_typ = f"{abs_output}.tmp_{os.getpid()}_{int(time.time()*1000)}.typ"
    try:
        with open(tmp_typ, "w", encoding="utf-8") as f:
            f.write(typst_template)

        cmd = [TYPST_BIN, "compile", "--root", "/", tmp_typ, abs_output]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60)
    finally:
        if os.path.exists(tmp_typ):
            try:
                os.remove(tmp_typ)
            except OSError:
                pass

    if res.returncode == 0 and os.path.exists(abs_output) and os.path.getsize(abs_output) > 0:
        print(f"Erfolg: PDF erzeugt -> {abs_output}")
        if open_preview:
            subprocess.run(["open", abs_output], timeout=60)
        return True
    else:
        print(f"Fehler bei Typst-Kompilierung:\n{res.stderr}", file=sys.stderr)
        return False

convert_txt_to_3col_pdf = convert_txt_to_pdf

def normalize_cli_args(raw_args):
    """Normalisiert CLI-Argumente, sodass -p auch als stand-alone Flag ohne Wert übergeben werden kann."""
    norm = []
    i = 0
    while i < len(raw_args):
        a = raw_args[i]
        norm.append(a)
        if a == "-p":
            if i + 1 >= len(raw_args) or raw_args[i + 1].startswith("-"):
                norm.append("true")
        i += 1
    return norm

class SingleLineHelpFormatter(argparse.HelpFormatter):
    def _split_lines(self, text, width):
        return [text]

def main():
    BLUE = "\033[94m"
    RESET = "\033[0m"

    fmt_help = (
        f"Format: {BLUE}atk{RESET} (Artikel, 3 Spalten, Garamond, mit Linie, Titel: Didot 36pt zentriert; Standard), "
        f"{BLUE}br2{RESET} (Bericht, 2 Spalten, PT Serif), "
        f"{BLUE}br1{RESET} (Bericht, 1 Spalte, PT Serif), "
        f"{BLUE}apa{RESET} (7. Edition APA-Bericht, US-Letter)"
    )
    size_help = f"Textgröße ({BLUE}6pt{RESET} bis {BLUE}12pt{RESET}; Standard: 10pt bei atk, 12pt bei br2/br1; entfällt bei apa)"
    font_help = f"Schriftart ({BLUE}Garamond{RESET}, {BLUE}Times New Roman{RESET}, {BLUE}PT Serif{RESET}, {BLUE}Optima{RESET}, {BLUE}Didot{RESET}, {BLUE}Cochin{RESET}, {BLUE}Big Caslon{RESET}, {BLUE}Baskerville{RESET}, {BLUE}Faustina{RESET}, {BLUE}Roboto{RESET}, {BLUE}Monaco{RESET})"
    margin_help = f"Ränder ({BLUE}k{RESET} (klein; Standard bei atk), {BLUE}m{RESET} (mittel), {BLUE}g{RESET} (groß); entfällt bei apa)"

    parser = argparse.ArgumentParser(
        prog="txt2pdf",
        formatter_class=lambda prog: SingleLineHelpFormatter(prog, max_help_position=16, width=220),
        description="Wandelt Text- und RTF-Dateien in typografische PDFs via Typst um.",
        add_help=False
    )
    parser.add_argument("-h", action="help", help="Hilfe anzeigen")
    parser.add_argument("-f", dest="format_preset", metavar="FORMAT", default="atk", help=fmt_help)
    parser.add_argument("-z", dest="font_family", metavar="SCHRIFT", default=None, help=font_help)
    parser.add_argument("-s", dest="size", metavar="GRÖßE", default=None, help=size_help)
    parser.add_argument("-r", dest="margins", metavar="RÄNDER", default=None, help=margin_help)
    img_help = f"Abbildung einbetten ({BLUE}##Pfad/zur/Datei{RESET} in .txt/.md an gewünschter Stelle; .png/.jpg/.jpeg/.webp/.pdf)"
    parser.add_argument("-i", dest="images", metavar="BILD", action="append", default=[], help=img_help)
    parser.add_argument("-a", dest="author", metavar="AUTOR", default=None, help="Autor")
    parser.add_argument("-t", dest="title", metavar="TITEL", default=None, help="Titel")
    parser.add_argument("-d", dest="date", metavar="DATUM", default=None, help="Datum")
    lang_help = f"Übersetzung via DeepL ({BLUE}en{RESET}, {BLUE}de{RESET}, etc.; optional)"
    parser.add_argument("-l", dest="target_lang", metavar="SPRACHE", default=None, help=lang_help)
    parser.add_argument("-o", dest="output", metavar="AUSGABE", default=None, help="Ausgabepfad (.pdf)")
    parser.add_argument("--install-fonts", dest="install_fonts", action="store_true", default=False, help="Kernschriftarten überprüfen und installieren")
    parser.add_argument("input_file", nargs="?", metavar="DATEI", default=None, help="Text- oder RTF/RTFD-Datei (.txt/.md/.rtf/.rtfd)")

    normalized_args = normalize_cli_args(sys.argv[1:])
    args = parser.parse_args(normalized_args)

    if args.install_fonts:
        success = install_core_fonts()
        sys.exit(0 if success else 1)

    if not args.input_file:
        parser.print_help()
        sys.exit(1)

    final_output = args.output
    final_title = args.title
    final_author = args.author
    final_date = args.date
    final_target_lang = args.target_lang
    final_margins = args.margins
    all_images = args.images or []
    fmt = (args.format_preset or "atk").lower().strip()
    final_font_size = args.size if fmt != "apa" else None
    final_font = args.font_family

    success = convert_txt_to_pdf(
        args.input_file,
        output_path=final_output,
        title=final_title,
        author=final_author,
        date=final_date,
        font_size=final_font_size,
        font=final_font,
        images=all_images,
        open_preview=False,
        format_preset=fmt,
        target_lang=final_target_lang,
        margins=final_margins
    )
    sys.exit(0 if success else 1)

if __name__ == "__main__":
    main()
