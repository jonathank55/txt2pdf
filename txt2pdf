def escape_typst_line(line: str) -> str:
    """Maskiert typst-spezifische Sonderzeichen außerhalb von gewollten Formatierungen."""
    chars_to_escape = ["#", "$", "@", "[", "]", "*", "<", ">"]
    res = line
    for c in chars_to_escape:
        res = res.replace(c, f"\\{c}")
    res = res.replace("//", r"\/\/").replace("/*", r"\/\*").replace("*/", r"\*\/")
    return res

def format_content_to_typst(text: str) -> str:
    """Konvertiert Markdown-Formatierungen sicher und maskiert alle übrigen Typst-Sonderzeichen."""
    # 1. Links schützen (Markdown [label](url) und reine bare URLs)
    links = []

    def save_md_link(m):
        label = m.group(1)
        url = m.group(2)
        idx = len(links)
        links.append(f'#link("{url}")[{escape_typst_line(label)}]')
        return f'TYPSTPLCHLDRLINK{idx}END'

    def save_bare_url(m):
        url = m.group(0).rstrip('.,;:)"\'')
        trailing = m.group(0)[len(url):]
        idx = len(links)
        links.append(f'#link("{url}")')
        return f'TYPSTPLCHLDRLINK{idx}END{trailing}'

    text = re.sub(r'\[([^\]]+)\]\((https?://[^\s\)]+)\)', save_md_link, text)
    text = re.sub(r'https?://[^\s<>"\'\[\]]+', save_bare_url, text)

    def save_bare_doi(m):
        prefix = m.group(1)
        doi_val = m.group(2).rstrip('.,;:)"\'')
        trailing = m.group(2)[len(doi_val):]
        idx = len(links)
        links.append(f'{escape_typst_line(prefix)}#link("https://doi.org/{doi_val}")[https://doi.org/{doi_val}]')
        return f'TYPSTPLCHLDRLINK{idx}END{trailing}'

    text = re.sub(r'\b(doi:\s*)(10\.\d{4,9}/[^\s<>"\'\[\]]+)', save_bare_doi, text, flags=re.I)

    # 2. Fettung schützen (**bold** und __bold__)
    strongs = []
    def save_strong(m):
        inner = m.group(1)
        idx = len(strongs)
        strongs.append(f'#strong[{escape_typst_line(inner)}]')
        return f'TYPSTPLCHLDRSTRONG{idx}END'

    text = re.sub(r'\*\*(.+?)\*\*', save_strong, text)
    text = re.sub(r'__(.+?)__', save_strong, text)

    # 3. Gedankenstriche normalisieren (Halbgeviertstrich-Invariante)
    text = text.replace("—", " – ").replace("---", "--")
    text = re.sub(r'\s*–\s*', ' – ', text)

    # 4. Verbleibende Typst-Sonderzeichen und Kommentarzeichen maskieren (verhindert unclosed delimiter / math / label-Kollisionen)
    for c in ["#", "$", "@", "[", "]", "*", "<", ">", "_"]:
        text = text.replace(c, f"\\{c}")
    text = text.replace("//", r"\/\/").replace("/*", r"\/\*").replace("*/", r"\*\/")

    # 5. Geschützte Tokens wieder einsetzen
    for idx, s in enumerate(strongs):
        text = text.replace(f'TYPSTPLCHLDRSTRONG{idx}END', s)

    for idx, l in enumerate(links):
        text = text.replace(f'TYPSTPLCHLDRLINK{idx}END', l)

    return text

def convert_markdown_formatting_to_typst(text: str) -> str:
    return format_content_to_typst(text)

def apply_initial_to_typst_element(content: str, font_spec: str = None) -> str:
    """Wendet ein typografisches großes Initial (Drop Cap) via droplet mit der Titelschriftart auf den Beginn eines Typst-Fließtextblocks an."""
    s = content.strip()
    if not s or s.startswith("#dropcap") or s.startswith("#table") or s.startswith("- ") or s.startswith("#grid") or s.startswith("#align"):
        return s
    initial_font = font_spec if font_spec else FONT_DEFINITIONS["didot"]["spec"]
    return (
        f"#dropcap(\n"
        f"  height: 4,\n"
        f"  gap: 3pt,\n"
        f"  justify: true,\n"
        f"  transform: it => text(font: {initial_font}, weight: \"bold\", it)\n"
        f")[{s}]"
    )

def is_heading_sentence(text: str) -> bool:
    """Erkennt deterministisch, ob ein Absatz aus einem einzelnen Satz oder einer kurzen Phrase (mit oder ohne Punkt) als Überschrift besteht."""
    s = text.strip()
    if not s or len(s) > 350:
        return False
    if is_apa_citation(s):
        return False
    if s.startswith(("http://", "https://", "www.", "doi:")) or re.match(r"^https?://", s):
        return False
    if any(s.lower().startswith(w) for w in ["und ", "oder ", "aber ", "denn ", "weil ", "dass ", "wenn ", "obwohl ", "währenddessen "]):
        return False
    # Wenn kein Satzendepunkt vorliegt
    if not s.endswith((".", "!", "?", "...", ";", ":")):
        return True
    # Falls Punkt am Ende vorliegt: prüfen, ob es genau 1 Satz ist (keine internen Satzgrenzen)
    clean = re.sub(
        r"\b(?:z\. B\.|d\. h\.|u\. a\.|u\. ä\.|bzw\.|ca\.|evtl\.|inkl\.|Dr\.|Prof\.|Hr\.|Fr\.|Nr\.|Abs\.|Art\.|Vgl\.|vgl\.|S\.|ff\.|etc\.|e\.g\.|i\.e\.)",
        "ABBR",
        s,
        flags=re.IGNORECASE
    )
    inner = clean[:-1].strip()
    internal_boundaries = re.findall(r"[\.\!\?]\s+[A-ZÄÖÜ]", inner)
    return len(internal_boundaries) == 0

def is_single_sentence(text: str) -> bool:
    """Erkennt deterministisch, ob ein Absatz aus genau 1 Satz mit Punkt am Ende besteht."""
    s = text.strip()
    if not s.endswith((".", "!", "?")):
        return False
    if len(s) < 10 or len(s) > 350:
        return False
    clean = re.sub(
        r"\b(?:z\. B\.|d\. h\.|u\. a\.|u\. ä\.|bzw\.|ca\.|evtl\.|inkl\.|Dr\.|Prof\.|Hr\.|Fr\.|Nr\.|Abs\.|Art\.|Vgl\.|vgl\.|S\.|ff\.|etc\.|e\.g\.|i\.e\.)",
        "ABBR",
        s,
        flags=re.IGNORECASE
    )
    inner = clean[:-1].strip()
    internal_boundaries = re.findall(r"[\.\!\?]\s+[A-ZÄÖÜ]", inner)
    return len(internal_boundaries) == 0

def is_author_name(candidate: str) -> bool:
    """Prüft zuverlässig, ob eine Zeichenkette den Namen einer realen Person / Autors darstellt."""
    if not candidate:
        return False
    s = candidate.strip()
    if len(s) < 3 or len(s) > 60:
        return False
    if s.lower() in ("jonathan klatchko", "yona klatchko"):
        return True
    # Eine Zeile in Versalien (ALL CAPS) mit mehreren Wörtern ist eine Überschrift, niemals ein Autor
    if s.isupper() and len(s.split()) > 1:
        return False
    if s.startswith(("-", "–", "—", "#", "*", ">", "•")):
        return False
    if s.endswith((".", "!", "?", ";", ":", "«", "»", "\"", "“", "”")):
        if not re.search(r"\b[A-ZÄÖÜ]\.$", s):
            return False
    m_pref = re.match(r"^(?:autor|author|von|by|verfasser|written\s+by)\s*[:\-–—]?\s*(.+)$", s, re.IGNORECASE)
    if m_pref:
        s = m_pref.group(1).strip()

    title_pattern = r"^(?:(?:Dr\.|Prof\.|Prof\. Dr\.|PD|PhD|M\.A\.|B\.A\.|M\.Sc\.|B\.Sc\.)\s+)*"
    suffix_pattern = r"(?:,\s*(?:Ph\.?D\.?|M\.?A\.?|M\.?Sc\.?|B\.?A\.?|B\.?Sc\.?|LL\.?M\.?|CFA|MD|MBA))?$"
    s_clean = re.sub(title_pattern, "", s, flags=re.IGNORECASE)
    s_clean = re.sub(suffix_pattern, "", s_clean, flags=re.IGNORECASE).strip()

    if "," in s_clean:
        parts = [p.strip() for p in s_clean.split(",")]
        if len(parts) != 2 or len(parts[0].split()) > 2 or len(parts[1].split()) > 2:
            return False

    stopwords = {
        "der", "die", "das", "den", "dem", "des", "ein", "eine", "einer", "eines", "einem", "einen",
        "und", "oder", "aber", "denn", "weil", "dass", "wenn", "ob", "wie", "als",
        "im", "in", "am", "an", "auf", "aus", "bei", "mit", "nach", "von", "zu", "zum", "zur", "über", "unter", "vor", "durch", "für",
        "ist", "sind", "war", "waren", "wird", "werden", "hat", "haben", "hatte", "hatten", "kann", "können", "muss", "müssen",
        "kapitel", "chapter", "abschnitt", "section", "inhalt", "literatur", "literaturverzeichnis", "references", "quellen",
        "zusammenfassung", "abstract", "einleitung", "introduction", "fazit", "schluss", "anhang", "tabelle", "abbildung",
        "the", "a", "an", "and", "or", "but", "of", "for", "with", "from", "into", "is", "are", "was", "were",
        "wer", "wen", "wem", "wessen", "was", "wo", "woher", "wohin", "wann", "warum", "weshalb", "wieso", "welcher", "welche", "welches",
        "who", "whom", "whose", "what", "which", "where", "when", "why", "how",
        "artikel", "aufsatz", "bericht", "essay", "notiz", "notizen", "entwurf", "text", "dokument", "paper", "report", "draft", "article",
        "kolumne", "kommentar", "lehrbuch", "manuskript", "übersicht", "gliederung",
        "schwitzt", "herrscht", "denkt", "schreibt", "sagt", "geht", "kommt", "steht", "liegt", "bleibt", "sieht", "zeigt", "lebt", "stirbt", "zahlt", "kostet"
    }

    words = re.findall(r"[A-Za-zÄÖÜäöüß]+(?:-[A-Za-zÄÖÜäöüß]+)?|\b[A-ZÄÖÜ]\.", s_clean)
    if not (1 <= len(words) <= 5):
        return False

    for w in words:
        if w.lower() in stopwords:
            return False
        if not (w[0].isupper() or w.lower() in ("von", "van", "de", "der", "zu")):
            return False

    return True

def parse_title_author_from_filename(base_name: str) -> Tuple[Optional[str], Optional[str]]:
    """Extrahiert Titel und Autor deterministisch aus dem Dateinamen unter strikter Bewahrung aller Titel-Trennzeichen."""
    doc_prefixes = {
        "artikel", "aufsatz", "bericht", "essay", "notiz", "notizen", "entwurf", "text", 
        "dokument", "paper", "report", "draft", "article", "kolumne", "kommentar", "manuskript"
    }

    # 1. Explizite Trennung über Schlüsselwörter: Titel, von Autor / Titel by Autor
    m = re.search(r"^(.*?)\s*(?:,\s*)?\b(?:von|by|autor|author)\b\s*(.+)$", base_name, re.IGNORECASE)
    if m:
        c1 = m.group(1).strip()
        c2 = m.group(2).strip()
        if is_author_name(c2):
            return c1, c2
        if is_author_name(c1):
            return c2, c1

    # 2. Autor am Ende: Titel [Trenner] Autor (gierig nach dem letzten Trenner vor dem Autor suchen)
    m_end = re.search(r"^(.*)\s*(?:[:|]|\s+[-–—]\s+)\s*([^:|]+)$", base_name)
    if m_end:
        t_cand = m_end.group(1).strip()
        a_cand = m_end.group(2).strip()
        if is_author_name(a_cand):
            # Bereinige führendes Dokumenttyp-Präfix, falls vorhanden
            m_p = re.match(r"^(?:artikel|aufsatz|bericht|essay|notizen?|entwurf|text|dokument|paper|report|draft|article|kolumne|kommentar|manuskript)\s*[:|]\s*(.+)$", t_cand, re.IGNORECASE)
            if m_p:
                t_cand = m_p.group(1).strip()
            return (t_cand or None), a_cand

    # 3. Autor am Anfang: Autor [Trenner] Titel
    m_start = re.search(r"^([^:|]+)\s*(?:[:|]|\s+[-–—]\s+)\s*(.*?)$", base_name)
    if m_start:
        a_cand = m_start.group(1).strip()
        t_cand = m_start.group(2).strip()
        if is_author_name(a_cand) and a_cand.lower() not in doc_prefixes:
            return (t_cand or None), a_cand

    return None, None

def is_matching_title(candidate: str, target: str) -> bool:
    """Prüft deterministisch, ob zwei Titelbezeichnungen semantisch übereinstimmen."""
    if not candidate or not target:
        return False
    c_clean = re.sub(r"^[#\s:|\-]+", "", unicodedata.normalize("NFC", candidate)).strip().lower()
    t_clean = re.sub(r"^[#\s:|\-]+", "", unicodedata.normalize("NFC", target)).strip().lower()
    return c_clean == t_clean

def is_apa_citation(text: str) -> bool:
    """Erkennt deterministisch, ob ein Absatz einen normgerechten APA-Quellennachweis darstellt."""
    s = text.strip()
    if len(s) < 10:
        return False
    if bool(extract_isbns_from_text(s)):
        return True
    m_yr = re.search(r"\(\s*(?:(?:19|20)\d{2}|n\.d\.|o\.\s*D\.)(?:,\s*[^)]+)?\s*\)", s)
    if not m_yr:
        return False
    prefix = s[:m_yr.start()].strip()
    if not prefix or len(prefix) > 150:
        return False
    if any(k in s for k in ("http://", "https://", "doi.org", "doi:", "S.", "pp.", "Vol.", "Nr.", "Issue", "Hrsg.", "Ed.", "Eds.", "In ", "in ")):
        return True
    after = s[m_yr.end():].strip()
    if after.startswith((".", ":")):
        return True
    return False

def clean_isbn(raw: str) -> Optional[str]:
    """Bereinigt einen ISBN-String und behält nur Ziffern sowie das Prüfzeichen X."""
    if not raw:
        return None
    s = re.sub(r"[^0-9X]", "", raw.upper())
    if len(s) in (10, 13):
        return s
    return None

def is_valid_isbn(raw: str) -> bool:
    """Validiert eine ISBN-10 oder ISBN-13 deterministisch über ihre Prüfziffer."""
    s = clean_isbn(raw)
    if not s:
        return False
    if len(s) == 10:
        total = sum((10 - i) * (10 if c == "X" else int(c)) for i, c in enumerate(s))
        return total % 11 == 0
    elif len(s) == 13:
        total = sum(int(c) * (1 if i % 2 == 0 else 3) for i, c in enumerate(s))
        return total % 10 == 0
    return False

def extract_isbns_from_text(text: str) -> List[str]:
    """Extrahiert alle gültigen ISBN-10 und ISBN-13 Nummern aus einem Text."""
    m13 = re.findall(r"\b(?:ISBN(?:-13)?:?\s*)?(97[89][\s\-]*(?:\d[\s\-]*){9}\d)\b", text, re.I)
    m10 = re.findall(r"\b(?:ISBN(?:-10)?:?\s*)?(\d[\s\-]*(?:\d[\s\-]*){8}[\dXx])\b", text, re.I)
    res = []
    for cand in m13 + m10:
        c = clean_isbn(cand)
        if c and is_valid_isbn(c) and c not in res:
            res.append(c)
    return res

def parse_editor_name_to_apa(raw_name: str) -> str:
    """Wandelt einen Herausgebernamen in das Format Initialen Nachname nach APA 7 um."""
    apa_last_init = parse_author_name_to_apa(raw_name)
    if "," in apa_last_init:
        parts = [p.strip() for p in apa_last_init.split(",", 1)]
        return f"{parts[1]} {parts[0]}".strip()
    return apa_last_init

def format_editors_apa(editors_list: list, is_en: bool = False) -> str:
    """Formatiert eine Liste von Herausgebern standardkonform nach APA 7 (Initialen Nachname (Hrsg.) bzw. (Eds.))."""
    cleaned = []
    for ed in editors_list:
        p = parse_editor_name_to_apa(ed)
        if p and p not in cleaned:
            cleaned.append(p)
    if not cleaned:
        return ""
    if len(cleaned) == 1:
        ed_str = cleaned[0]
        label = "Ed." if is_en else "Hrsg."
    elif len(cleaned) <= 20:
        ed_str = ", ".join(cleaned[:-1]) + " & " + cleaned[-1]
        label = "Eds." if is_en else "Hrsg."
    else:
        ed_str = ", ".join(cleaned[:19]) + ", ... " + cleaned[-1]
        label = "Eds." if is_en else "Hrsg."
    return f"{ed_str} ({label})"

def clean_url_string(raw_u: str) -> str:
    """Bereinigt URLs unter Beibehaltung balancierter Klammern in DOIs und Pfaden."""
    u = raw_u.strip().rstrip('.,;:>"\'')
    while u.endswith(')') and u.count(')') > u.count('('):
        u = u[:-1]
    return u

def extract_urls_from_text(text: str) -> List[str]:
    """Extrahiert alle eindeutigen HTTP/HTTPS-URLs aus einem Dokument."""
    md_urls = re.findall(r'\[(?:[^\]]+)\]\((https?://[^\s\)]+)\)', text)
    bare_urls = re.findall(r'https?://[^\s<>\"\'\[\]]+', text)
    
    all_urls = []
    seen = set()
    for u in md_urls + bare_urls:
        cleaned_url = clean_url_string(u)
        if cleaned_url and cleaned_url not in seen:
            seen.add(cleaned_url)
            all_urls.append(cleaned_url)
    return all_urls

def parse_author_name_to_apa(raw_name: str) -> str:
    """Wandelt einen Personennamen deterministisch in das standardisierte APA-Format (Nachname, Initialen) um."""
    s = unescape(raw_name).strip().rstrip(".,;:")
    # Titel und akademische Grade bereinigen
    s = re.sub(r"^(?:Prof\.|Dr\.|PD|Dipl\.-[A-Za-z]+|M\.Sc\.|B\.Sc\.|Dr\. med\.)\s+", "", s, flags=re.I).strip()
    if not s:
        return ""
    if "," in s:
        parts = [p.strip() for p in s.split(",", 1)]
        last = parts[0]
        first = parts[1]
        first_tokens = [t for t in first.split() if t and not t.endswith(".")]
        first_inits = [t for t in first.split() if t and t.endswith(".")]
        inits = " ".join([f"{t[0]}." for t in first_tokens] + first_inits)
        return f"{last}, {inits}".strip()
    tokens = s.split()
    if len(tokens) == 1:
        return tokens[0]
    prefixes = {"an", "der", "von", "van", "de", "den", "zu", "ter", "vom", "di", "del", "da"}
    if len(tokens) >= 3 and tokens[-3].lower() in prefixes:
        last = " ".join(tokens[-3:])
        first_tokens = tokens[:-3]
    elif len(tokens) >= 2 and tokens[-2].lower() in prefixes:
        last = " ".join(tokens[-2:])
        first_tokens = tokens[:-2]
    else:
        last = tokens[-1]
        first_tokens = tokens[:-1]
    inits = " ".join(f"{t[0]}." for t in first_tokens if t)
    return f"{last}, {inits}".strip()

def format_authors_apa(authors_list: List[str]) -> str:
    """Verbindet eine Liste von Autorennamen standardkonform nach APA 7."""
    cleaned = []
    seen = set()
    for a in authors_list:
        apa = parse_author_name_to_apa(a)
        if apa and apa.lower() not in seen:
            seen.add(apa.lower())
            cleaned.append(apa)
    if not cleaned:
        return ""
    if len(cleaned) == 1:
        return cleaned[0]
    if len(cleaned) <= 20:
        return ", ".join(cleaned[:-1]) + " & " + cleaned[-1]
    return ", ".join(cleaned[:19]) + ", ... " + cleaned[-1]

def extract_authors_from_json_ld(html_text: str) -> List[str]:
    """Extrahiert Autorennamen aus eingebetteten JSON-LD / Schema.org Datenblöcken."""
    authors = []
    scripts = re.findall(r"<script[^>]+type=[\'\"]application/ld\+json[\'\"][^>]*>(.*?)</script>", html_text, re.I | re.S)
    for s in scripts:
        try:
            data = json.loads(s.strip())
            items = data if isinstance(data, list) else [data]
            for item in items:
                auth = item.get("author") or item.get("creator")
                if isinstance(auth, list):
                    for a in auth:
                        if isinstance(a, dict) and a.get("name"):
                            authors.append(a["name"])
                        elif isinstance(a, str):
                            authors.append(a)
                elif isinstance(auth, dict) and auth.get("name"):
                    authors.append(auth["name"])
                elif isinstance(auth, str):
                    authors.append(auth)
        except Exception:
            pass
    return authors

def extract_authors_from_html(html_text: str) -> List[str]:
    """Extrahiert alle Personenautoren aus Dublin Core, Highwire Press, Standard-Meta und JSON-LD."""
    authors = []
    seen = set()

    for a in extract_authors_from_json_ld(html_text):
        a_clean = a.strip()
        if a_clean and a_clean.lower() not in seen:
            seen.add(a_clean.lower())
            authors.append(a_clean)

    meta_patterns = [
        r"<meta[^>]+(?:name|property)=[\'\"](?:citation_author|dc\.creator|author|article:author|dc\.contributor\.author|byl|sailthru\.author|parsely-author)[\'\"][^>]+content=[\'\"]([^\'\"]+)[\'\"]",
        r"<meta[^>]+content=[\'\"]([^\'\"]+)[\'\"][^>]+(?:name|property)=[\'\"](?:citation_author|dc\.creator|author|article:author|dc\.contributor\.author)[\'\"]"
    ]
    for pat in meta_patterns:
        for m in re.finditer(pat, html_text, re.I):
            val = unescape(m.group(1)).strip()
            if ";" in val:
                subs = [sp.strip() for sp in val.split(";") if sp.strip()]
            else:
                subs = [val]
            for sp in subs:
                if sp and sp.lower() not in seen and len(sp) <= 80:
                    if not any(stop in sp.lower() for stop in ["redaktion", "admin", "editorial", "team", "verlag", "press"]):
                        seen.add(sp.lower())
                        authors.append(sp)
    return authors

CITATION_CACHE_FILE = os.path.expanduser("~/.gemini/config/cache/citations_cache.json")

def load_citation_cache() -> Dict[str, dict]:
    """Lädt gecachte Zitationsmetadaten."""
    if os.path.exists(CITATION_CACHE_FILE):
        try:
            with open(CITATION_CACHE_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
