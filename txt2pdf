def normalize_cli_args(raw_args):
    """Normalisiert CLI-Argumente, sodass -p auch als stand-alone Flag ohne Wert übergeben werden kann."""
    norm = []
    i = 0
    while i < len(raw_args):
        a = raw_args[i]
        norm.append(a)
        if a == "-p":
            if i + 1 >= len(raw_args) or raw_args[i + 1].startswith("-"):
                norm.append("true")
        i += 1
    return norm

class SingleLineHelpFormatter(argparse.HelpFormatter):
    def _split_lines(self, text, width):
        return [text]

def main():
    BLUE = "\033[94m"
    RESET = "\033[0m"

    fmt_help = (
        f"Format: {BLUE}atk{RESET} (Artikel, 3 Spalten, Initial, DIN-A4), "
        f"{BLUE}br1{RESET} (Bericht, 1 Spalte, DIN-A4), "
        f"{BLUE}br2{RESET} (Bericht, 2 Spalten, DIN-A4), "
        f"{BLUE}apa{RESET} (7. Edition APA-Bericht, US-Letter)"
    )
    size_help = f"Textgröße ({BLUE}6pt{RESET} bis {BLUE}12pt{RESET}; entfällt bei apa)"

    parser = argparse.ArgumentParser(
        prog="txt2pdf",
        formatter_class=lambda prog: SingleLineHelpFormatter(prog, max_help_position=16, width=220),
        description="Wandelt Text- und RTF-Dateien in typografische PDFs via Typst um.",
        add_help=False
    )
    parser.add_argument("-h", action="help", help="Hilfe anzeigen")
    parser.add_argument("-f", dest="format_preset", metavar="FORMAT", default="atk", help=fmt_help)
    parser.add_argument("-s", dest="size", metavar="GRÖßE", default=None, help=size_help)
    img_help = f"Abbildung einbetten ({BLUE}##Pfad/zur/Datei{RESET} in .txt/.md an gewünschter Stelle; .png/.jpg/.jpeg/.webp/.pdf)"
    parser.add_argument("-i", dest="images", metavar="BILD", action="append", default=[], help=img_help)
    parser.add_argument("-a", dest="author", metavar="AUTOR", default=None, help="Autor")
    parser.add_argument("-t", dest="title", metavar="TITEL", default=None, help="Titel")
    parser.add_argument("-d", dest="date", metavar="DATUM", default=None, help="Datum")
    parser.add_argument("-o", dest="output", metavar="AUSGABE", default=None, help="Ausgabepfad (.pdf)")
    parser.add_argument("input_file", metavar="DATEI", help="Text- oder RTF/RTFD-Datei (.txt/.md/.rtf/.rtfd)")

    normalized_args = normalize_cli_args(sys.argv[1:])
    args = parser.parse_args(normalized_args)

    final_output = args.output
    final_title = args.title
    final_author = args.author
    final_date = args.date
    all_images = args.images or []
    fmt = (args.format_preset or "artikel").lower().strip()
    final_font_size = args.size if fmt != "apa" else None

    success = convert_txt_to_pdf(
        args.input_file,
        output_path=final_output,
        title=final_title,
        author=final_author,
        date=final_date,
        font_size=final_font_size,
        images=all_images,
        open_preview=False,
        format_preset=fmt
    )
    sys.exit(0 if success else 1)

if __name__ == "__main__":
    main()
